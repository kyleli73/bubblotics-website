---
/*
 * ═══════════════════════════════════════════════════════════════════════════
 *  HOME
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * One scrolling page, built as stacked full-bleed bands separated by 2px
 * rules rather than as floating cards on a background. Content sits flush
 * left inside the shell, so every heading, paragraph and grid starts on the
 * same vertical line all the way down. That single alignment does more for
 * how deliberate the page feels than any amount of decoration.
 *
 * Order is who we are, what we build, what we write, who backs us. A visitor
 * arriving from an Instagram link gives a page a few seconds, and the first
 * screen has to answer "what is this" before it asks for anything.
 *
 * ── Rules this page follows ────────────────────────────────────────────
 *   Structural blocks are square. Radius is for controls and media only.
 *   Section boundaries are 2px, using var(--edge).
 *   Yellow is the accent and stays rare: the sponsors banner, the active
 *     rail marker, one word per heading. If it starts showing up in body
 *     copy it has stopped meaning anything.
 *   Nothing invented. Where a photo or a result does not exist yet there
 *     is a labelled Placeholder naming the file path, never filler.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bubbles from '../components/Bubbles.astro';
import StatStrip from '../components/StatStrip.astro';
import ScrollRail from '../components/ScrollRail.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { team, subteams, outreach, sponsorTiers } from '../data/site';
import { homeSoftware, picklistColumns } from '../data/software';
import { url } from '../lib/paths';

const robots = (await getCollection('robots', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.order - a.data.order
);
const currentRobot = robots[0];

const posts = (await getCollection('updates', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const dateFmt = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

/* Rail stops, in document order. Each id must exist as a section below. */
const railSections = [
  { id: 'team', label: 'Team' },
  { id: 'build', label: 'Build' },
  { id: 'software', label: 'Software' },
  { id: 'gallery', label: 'Gallery' },
  { id: 'updates', label: 'Updates' },
  { id: 'outreach', label: 'Outreach' },
];

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  planned: 'Planned',
};

/* Every sponsor across every tier. Empty today, which the grid handles. */
const sponsors = sponsorTiers.flatMap((t) => t.members);
---

<BaseLayout title={`${team.name} · FTC Team ${team.number}`} bareTitle>
  <ScrollRail sections={railSections} />

  <!-- ═══ HERO ═══════════════════════════════════════════════════════════
       Full-bleed Prussian navy. The bubble field is a canvas, not DOM
       nodes: at this count, animating spans would repaint layout on every
       frame, and mouse-repel plus click-to-pop needs per-pixel hit testing
       that DOM elements cannot do cheaply.
  -->
  <section class="hero" id="top" data-hero>
    <Bubbles count={26} tone="full" />

    <div class="shell hero-inner" data-hero-content>
      <p class="hero-eyebrow" data-hero-item>
        <Icon name="location" size={13} />
        {team.location}
        <span class="hero-dot" aria-hidden="true">/</span>
        {team.program}
      </p>

      <h1 class="hero-title" data-hero-title>
        <span class="hero-word">Bubblotics</span>
        <span class="hero-num">Team 35858</span>
      </h1>

      <p class="hero-tagline" data-hero-item>{team.tagline}</p>

      <p class="hero-lead" data-hero-item>{team.blurb.split('. ')[0]}.</p>

      <div class="cluster hero-actions" data-hero-item>
        <a href={url('/robots/')} class="btn btn-primary">
          See our robots
          <Icon name="arrow" size={16} />
        </a>
        <a href={url('/about/')} class="btn btn-ghost">Our story</a>
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true">
      <span class="scroll-hint-line"></span>
      Scroll
    </div>
  </section>

  <StatStrip />

  <!-- ═══ 01 · WHO WE ARE ════════════════════════════════════════════ -->
  <section class="band" id="team">
    <div class="shell">
      <p class="eyebrow">01 / Who we are</p>
      <h2 class="band-title" data-reveal>
        A student team that builds <span class="accent-word">real machines</span>
      </h2>

      <p class="band-lead">{team.blurb}</p>

      <ul class="subteams" data-reveal data-stagger>
        {
          subteams.map((s, i) => (
            <li class="subteam">
              <span class="subteam-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.description}</p>
            </li>
          ))
        }
      </ul>

      <div class="wide-media" data-reveal>
        <Placeholder path="src/assets/team/team-photo.jpg" ratio="21 / 9">
          A wide shot of the whole team, ideally in the workspace with the
          robot. This is the one photo most visitors will actually look at.
        </Placeholder>
      </div>

      <a href={url('/about/')} class="link-arrow band-link">
        Read our story
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ═══ 02 · WHAT WE ARE BUILDING ══════════════════════════════════ -->
  <section class="band" id="build">
    <div class="shell">
      <p class="eyebrow">02 / The build</p>
      <h2 class="band-title" data-reveal>
        What we are <span class="accent-word">building</span>
      </h2>

      <p class="band-lead">
        BIOBUZZ will be our first competition season. Until then we are
        learning on an offseason robot, and everything we work out along the
        way gets written down here.
      </p>

      {
        currentRobot && (
          <article class="feature" data-reveal>
            <div class="feature-media">
              <Placeholder
                path="src/assets/robots/offseason.jpg"
                ratio="4 / 3"
                kind="Robot"
              >
                The offseason robot, three-quarter view, on a clean
                background. Then uncomment `heroImage` in
                src/content/robots/offseason-decode.md.
              </Placeholder>
            </div>

            <div class="feature-body">
              <p class="feature-meta">
                Season 01
                <span aria-hidden="true">/</span>
                {currentRobot.data.season}
              </p>
              <h3 class="feature-title">{currentRobot.data.name}</h3>
              <p class="feature-summary">{currentRobot.data.summary}</p>

              <a
                href={url(`/robots/${currentRobot.id}/`)}
                class="link-arrow"
              >
                Robot details
                <Icon name="arrow" size={16} />
              </a>
            </div>
          </article>
        )
      }

      <!--
        The next season, stated as not existing. An empty slot that says
        why it is empty is worth more than hiding the row until there is
        something to put in it: it shows a visitor where this is going.
      -->
      <div class="upnext" data-reveal>
        <span class="upnext-num">Season 02</span>
        <div class="upnext-body">
          <h3>Not yet built</h3>
          <p>
            The BIOBUZZ robot starts once the game is released. This row
            fills in when it exists.
          </p>
        </div>
        <span class="upnext-tag">Pending</span>
      </div>
    </div>
  </section>

  <!-- ═══ 03 · SOFTWARE ══════════════════════════════════════════════ -->
  <section class="band" id="software">
    <div class="shell">
      <p class="eyebrow">03 / Software</p>
      <h2 class="band-title" data-reveal>
        Tools we <span class="accent-word">wrote ourselves</span>
      </h2>

      <p class="band-lead">
        Three strands, one of them running today. These are internal team
        tools, so there is nothing here to sign up for.
      </p>

      <ol class="soft-list" data-reveal data-stagger>
        {
          homeSoftware.map((item, i) => (
            <li class="soft">
              <span class="soft-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="soft-body">
                <h3>{item.name}</h3>
                <p>{item.purpose}</p>
              </div>
              <span class:list={['soft-status', `is-${item.status}`]}>
                {statusLabel[item.status]}
              </span>
            </li>
          ))
        }
      </ol>

      <!--
        What the scouting app produces, as a table of columns rather than
        rows of data. We have not been to an event, so there is no data.
        See the note in src/data/software.ts before adding example rows.
      -->
      <div class="table-block" data-reveal>
        <h3 class="table-title">What the picklist holds</h3>

        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Field</th>
                <th scope="col">Source</th>
                <th scope="col">What it is for</th>
              </tr>
            </thead>
            <tbody>
              {
                picklistColumns.map((row) => (
                  <tr>
                    <th scope="row">{row.field}</th>
                    <td>{row.source}</td>
                    <td>{row.use}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <p class="table-note">
          Structure only. There are no numbers here because we have not
          competed yet, and inventing some would make every other figure on
          this site worth doubting.
        </p>
      </div>

      <a href={url('/software/')} class="link-arrow band-link">
        All our software
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ═══ 04 · GALLERY ═══════════════════════════════════════════════ -->
  <section class="band" id="gallery">
    <div class="shell">
      <p class="eyebrow">04 / In the pits</p>
      <h2 class="band-title" data-reveal>Season <span class="accent-word">in photos</span></h2>

      <p class="band-lead">
        Six slots, waiting on photos. Drop files into src/assets/gallery/ and
        they appear here automatically, no code change needed.
      </p>

      <div class="gal-grid" data-reveal data-stagger>
        {
          Array.from({ length: 6 }, (_, i) => (
            <Placeholder
              path={`src/assets/gallery/0${i + 1}-name.jpg`}
              ratio="4 / 3"
            >
              {
                [
                  'Build session, hands on the robot.',
                  'The team at a competition.',
                  'A close crop of a mechanism.',
                  'Drive practice.',
                  'Mentoring an FLL team.',
                  'Something that went wrong, honestly captioned.',
                ][i]
              }
            </Placeholder>
          ))
        }
      </div>

      <a href={url('/gallery/')} class="link-arrow band-link">
        Full gallery
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ═══ 05 · UPDATES ═══════════════════════════════════════════════ -->
  <section class="band" id="updates">
    <div class="shell">
      <p class="eyebrow">05 / Latest</p>
      <h2 class="band-title" data-reveal>From the <span class="accent-word">workshop</span></h2>

      {
        posts.length > 0 ? (
          <ul class="post-list" data-reveal data-stagger>
            {posts.map((post) => (
              <li class="post">
                <div class="post-media">
                  <Placeholder
                    path={`src/assets/updates/${post.id}.jpg`}
                    ratio="3 / 2"
                  >
                    Cover image for this post.
                  </Placeholder>
                </div>

                <div class="post-body">
                  <p class="post-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {dateFmt.format(post.data.date)}
                    </time>
                    {post.data.tags[0] && (
                      <span class="post-tag">{post.data.tags[0]}</span>
                    )}
                  </p>

                  <h3 class="post-title">
                    <a href={url(`/updates/${post.id}/`)}>{post.data.title}</a>
                  </h3>

                  <p class="post-excerpt">{post.data.excerpt}</p>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="band-lead">
            No posts yet. See the README for how to add one.
          </p>
        )
      }

      <a href={url('/updates/')} class="link-arrow band-link">
        All updates
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>

  <!-- ═══ 06 · OUTREACH ══════════════════════════════════════════════ -->
  <section class="band" id="outreach">
    <div class="shell">
      <p class="eyebrow">06 / Outreach</p>
      <h2 class="band-title" data-reveal>
        The teams we <span class="accent-word">mentor</span>
      </h2>

      <div class="split-block">
        <div class="split-text" data-reveal>
          <p class="band-lead">{outreach[0].description}</p>
          <a href={url('/outreach/')} class="link-arrow">
            What they have won
            <Icon name="arrow" size={16} />
          </a>
        </div>

        <div class="split-media" data-reveal="right">
          <Placeholder path="src/assets/team/outreach.jpg" ratio="3 / 2">
            Our students working with an FLL team. Faces of minors need a
            signed photo release before this goes public.
          </Placeholder>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SPONSORS ═══════════════════════════════════════════════════
       The one full-bleed yellow band on the site. It is the only ask on
       the page, and being the single yellow surface is what makes it read
       as the thing to act on.
  -->
  <section class="sponsor-band" id="sponsors">
    <div class="shell">
      <p class="sponsor-eyebrow">Sponsors</p>
      <h2 class="sponsor-title" data-reveal>Help us build the first one</h2>

      <p class="sponsor-body">
        Sponsorship pays for the aluminium, the motors, the registration fees,
        and the bus. It also puts your name in front of every student, parent,
        and mentor at the events we attend.
      </p>

      <a href={url('/sponsors/')} class="btn btn-invert">
        Sponsor us
        <Icon name="arrow" size={16} />
      </a>

      <ul class="logo-grid">
        {
          sponsors.map((s) => (
            <li class="logo-slot is-filled">
              {s.url ? (
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.name}
                </a>
              ) : (
                <span>{s.name}</span>
              )}
            </li>
          ))
        }

        {/*
          Open slots, drawn rather than hidden. A grid with one logo and
          five gaps says "there is room here"; a grid with one logo alone
          says "nobody else signed up".
        */}
        {
          Array.from({ length: Math.max(0, 6 - sponsors.length) }, () => (
            <li class="logo-slot">
              <span>Open</span>
            </li>
          ))
        }
      </ul>

      <p class="sponsor-note">
        Logos go in public/images/sponsors/ and are listed in
        src/data/site.ts.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ HERO ═══════════════════════════════════════════════════════════ */

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    /* 100svh is the "small viewport height": the space left once a mobile
       browser's address bar is showing. Plain 100vh puts the bottom of the
       hero under the browser chrome on iOS. */
    min-height: 100svh;
    padding-top: calc(var(--header-h) + var(--sp-8));
    padding-bottom: var(--sp-9);
    overflow: hidden;
    background: var(--prussian);
    border-bottom: var(--edge);
  }

  .hero-inner {
    position: relative;
    z-index: var(--z-float);
    /* Flush left, like everything else. */
    text-align: left;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-5);
  }

  .hero-dot {
    color: var(--highlight);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    margin: 0;
  }

  .hero-word {
    display: block;
    font-size: var(--step-5);
    color: var(--ink);
  }

  /*
   * The team number, set as a wide-tracked rule line under the name. The
   * branding guide asks for Ethnocentric on the wordmark; that face is not
   * licensed, so this is the fallback the guide names: heavy display type
   * at wide letter-spacing.
   */
  .hero-num {
    display: block;
    margin-top: var(--sp-3);
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: var(--track-wordmark);
    color: var(--accent);
  }

  .hero-tagline {
    margin-top: var(--sp-6);
    padding-left: var(--sp-4);
    border-left: 3px solid var(--highlight);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--ink);
  }

  .hero-lead {
    margin-top: var(--sp-5);
    max-width: 56ch;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .hero-actions {
    margin-top: var(--sp-7);
  }

  .scroll-hint {
    position: absolute;
    bottom: var(--sp-6);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    z-index: var(--z-float);
  }

  .scroll-hint-line {
    width: 46px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--highlight));
  }

  @media (max-width: 640px) {
    .scroll-hint {
      display: none;
    }
  }

  /* ═══ BANDS ══════════════════════════════════════════════════════════
     Every major section is a band with a 2px rule under it. The rule is a
     bottom border rather than a top one so the last band before the yellow
     sponsors block does not double up on its edge. */

  .band {
    padding-block: var(--sp-9);
    border-bottom: var(--edge);
  }

  @media (min-width: 900px) {
    .band {
      padding-block: var(--sp-10);
    }
  }

  .band-title {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    margin: 0 0 var(--sp-5);
    max-width: 20ch;
  }

  .band-lead {
    max-width: 68ch;
    font-size: var(--step-1);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .band-link {
    margin-top: var(--sp-7);
  }

  /* ═══ SUBTEAMS ═══════════════════════════════════════════════════════ */

  .subteams {
    display: grid;
    gap: 0;
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
    border-top: var(--edge);
    border-left: var(--edge);
  }

  @media (min-width: 700px) {
    .subteams {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .subteams {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .subteam {
    padding: var(--sp-6);
    border-right: var(--edge);
    border-bottom: var(--edge);
  }

  .subteam-num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    color: var(--highlight);
    margin-bottom: var(--sp-4);
  }

  .subteam h3 {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
  }

  .subteam p {
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .wide-media {
    margin-top: var(--sp-8);
  }

  /* ═══ FEATURE ROBOT ══════════════════════════════════════════════════ */

  .feature {
    display: grid;
    gap: var(--sp-6);
    margin-top: var(--sp-8);
    padding-top: var(--sp-7);
    border-top: var(--edge);
  }

  @media (min-width: 860px) {
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-8);
      align-items: start;
    }
  }

  .feature-meta {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    display: flex;
    gap: var(--sp-3);
  }

  .feature-title {
    margin-top: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: var(--track-snug);
  }

  .feature-summary {
    margin: var(--sp-4) 0 var(--sp-6);
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--ink-muted);
  }

  /* ═══ SEASON 02, EMPTY ═══════════════════════════════════════════════ */

  .upnext {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
    margin-top: var(--sp-7);
    padding: var(--sp-6);
    border: 2px dashed var(--line-strong);
  }

  .upnext-num {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .upnext-body {
    flex: 1 1 22ch;
  }

  .upnext-body h3 {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }

  .upnext-body p {
    margin-top: var(--sp-2);
    font-size: var(--step--1);
    font-style: italic;
    color: var(--ink-muted);
  }

  .upnext-tag {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    padding: var(--sp-2) var(--sp-3);
    border: 2px solid var(--line-strong);
    color: var(--ink-faint);
  }

  /* ═══ SOFTWARE ═══════════════════════════════════════════════════════ */

  .soft-list {
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
    border-top: var(--edge);
  }

  .soft {
    display: grid;
    grid-template-columns: auto 1fr;
