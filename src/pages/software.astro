---
/*
 * Software.
 *
 * A roster of the tools the team has written: name, one line on what it is
 * for, and a way in. Modelled on how established teams list their internal
 * apps, which is a compact index rather than a set of walkthroughs. Someone
 * skimming this page wants to know what exists, not how to operate it.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { software, softwareIdeas } from '../data/software';
import { team } from '../data/site';

const statusLabel: Record<string, string> = {
  live: 'Live',
  'in-progress': 'In progress',
  planned: 'Planned',
};
---

<BaseLayout
  title="Software"
  description={`Tools built in-house by ${team.name}: offline-first match scouting, analytics, and parts inventory.`}
>
  <PageHero
    eyebrow="Software"
    title="Tools we <span class='accent-word'>wrote ourselves</span>"
    lead="Built by students on the team, for problems we actually hit in the shop and at competitions. These run internally, so there is nothing to sign up for here."
  />

  <section class="section section-tight">
    <div class="shell">
      <div class="grid grid-2" data-reveal data-stagger>
        {
          software.map((app) => (
            <article class="card app">
              <div class="app-head">
                <h2>{app.name}</h2>
                <span class:list={['tag', `is-${app.status}`]}>
                  {statusLabel[app.status]}
                </span>
              </div>

              <p class="app-purpose">{app.purpose}</p>

              {app.stack && (
                <ul class="stack">
                  {app.stack.map((s) => (
                    <li class="tag">{s}</li>
                  ))}
                </ul>
              )}

            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    softwareIdeas.length > 0 && (
      <section class="section section-tight">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow" data-reveal="fade">
              On the list
            </p>
            <h2 data-reveal>Scoped, not built</h2>
            <p data-reveal data-reveal-delay="0.06">
              Things we have specced out and intend to build. Listed
              separately on purpose: nothing here exists yet.
            </p>
          </div>

          <div class="grid grid-2" data-reveal data-stagger>
            {softwareIdeas.map((idea) => (
              <article class="card idea">
                <h3>{idea.name}</h3>
                <p>{idea.purpose}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    eyebrow="Talk shop"
    title="Want the details?"
    body="Happy to walk another team through how any of this works, or to share what we learned building it. Email us."
    primaryLabel="Contact us"
    primaryHref="/contact/"
    secondaryLabel="See the robots"
    secondaryHref="/robots/"
  />
</BaseLayout>

<style>
  .app {
    height: 100%;
  }

  .app-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .app-head h2 {
    font-size: var(--step-1);
    line-height: 1.15;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  /* Status is colour-coded, but the word is always there too: colour alone
     is not a label for anyone who cannot distinguish these hues. */
  .tag.is-live {
    border-color: rgba(120, 220, 150, 0.45);
    background: rgba(120, 220, 150, 0.12);
    color: #8fe6b0;
  }

  .tag.is-in-progress {
    border-color: rgba(255, 161, 1, 0.45);
    background: rgba(255, 161, 1, 0.12);
    color: var(--highlight);
  }

  .tag.is-planned {
    color: var(--ink-faint);
  }

  .app-purpose {
    color: var(--ink-muted);
    line-height: 1.65;
    max-width: 52ch;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
  }


  .idea h3 {
    font-size: var(--step-1);
    margin-bottom: var(--sp-3);
  }

  .idea p {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
  }
</style>
