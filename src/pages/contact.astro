---
/*
 * Contact.
 *
 * ── About the form ─────────────────────────────────────────────────────
 * A static site has no server, so there is nothing to receive a form POST.
 * The form below therefore does not submit anywhere. It assembles what the
 * visitor typed into a `mailto:` link and opens their email client with the
 * message pre-written.
 *
 * Why this and not a form service:
 *   - No third-party account for a future team to inherit and lose access to.
 *   - No data passing through anyone else's server.
 *   - It cannot silently stop working, which is the usual failure mode of a
 *     free form service abandoned three seasons ago.
 *
 * The trade-off is real: it needs a working mail client, and on a shared
 * school computer that may not exist. That is why the plain email address is
 * printed above the form as the primary path, not hidden behind it.
 *
 * If the team later wants true form submission, Formspree is the usual
 * choice. The README explains the swap.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { contact, activeSocials, team } from '../data/site';

const reasons = [
  { value: 'Sponsorship', label: 'I want to sponsor the team' },
  { value: 'Outreach request', label: 'I want the robot at my event' },
  { value: 'Joining the team', label: 'I want to join' },
  { value: 'Mentoring', label: 'I want to mentor' },
  { value: 'Something else', label: 'Something else' },
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${team.name}, FTC Team ${team.number}. Email ${contact.email} or find us on Instagram.`}
>
  <PageHero
    eyebrow="Contact"
    title="Say <span class='accent-word'>hello</span>"
    lead="Sponsorship, outreach bookings, joining the team, or a question about something on this site. We read everything."
  />

  <section class="section section-tight">
    <div class="shell">
      <div class="contact-grid">
        <!-- ── Direct details ──────────────────────────────────────── -->
        <div class="channels">
          <a href={`mailto:${contact.email}`} class="card channel">
            <span class="channel-icon">
              <Icon name="mail" size={20} />
            </span>
            <span class="channel-body">
              <span class="channel-label">Email</span>
              <span class="channel-value">{contact.email}</span>
              <span class="channel-note">
                The fastest way to reach us. We usually reply within a few
                days.
              </span>
            </span>
          </a>

          {
            activeSocials.map((s) => (
              <a
                href={s.url}
                class="card channel"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="channel-icon">
                  <Icon name={s.icon} size={20} />
                </span>
                <span class="channel-body">
                  <span class="channel-label">{s.name}</span>
                  <span class="channel-value">{s.handle}</span>
                  <span class="channel-note">
                    Build updates and competition days, posted through the
                    season.
                  </span>
                </span>
              </a>
            ))
          }

          <div class="card channel channel-static">
            <span class="channel-icon">
              <Icon name="location" size={20} />
            </span>
            <span class="channel-body">
              <span class="channel-label">Based in</span>
              <span class="channel-value">{team.location}</span>
              <span class="channel-note">
                We compete across Ontario, including provincials.
              </span>
            </span>
          </div>
        </div>

        <!-- ── Message composer ────────────────────────────────────── -->
        <div class="card form-card">
          <h2 class="form-title">Send us a message</h2>
          <p class="form-note faint">
            This opens your email app with the message ready to send. Nothing
            is submitted to a server, and nothing is stored on this site.
          </p>

          <form id="contact-form" novalidate>
            <div class="field">
              <label for="cf-name">Your name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="cf-org">Organisation <span class="optional">optional</span></label>
              <input id="cf-org" name="org" type="text" autocomplete="organization" />
            </div>

            <div class="field">
              <label for="cf-reason">What is this about?</label>
              <select id="cf-reason" name="reason">
                {reasons.map((r) => <option value={r.value}>{r.label}</option>)}
              </select>
            </div>

            <div class="field">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" rows="6" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary form-submit">
              <Icon name="mail" size={17} />
              Open in my email app
            </button>

            <!--
              aria-live means a screen reader announces this the moment it
              changes, without the user having to go looking for it. A
              validation message nobody hears is not a validation message.
            -->
            <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
          </form>

          <p class="form-fallback">
            Email not opening? Write to
            <a href={`mailto:${contact.email}`}>{contact.email}</a> directly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────────────────── -->
  <section class="section section-tight">
    <div class="shell shell-narrow">
      <div class="section-head">
        <p class="eyebrow" data-reveal="fade">Before you write</p>
        <h2 data-reveal>Common questions</h2>
      </div>

      <div class="faq" data-reveal data-stagger>
        <details class="card faq-item">
          <summary>How do I join the team?</summary>
          <p>
            <span class="ph-tag">[Placeholder]</span> Explain who is eligible,
            when recruitment happens, and what the time commitment looks like.
            Say plainly whether prior experience is needed, because that is the
            question keeping most people from asking.
          </p>
        </details>

        <details class="card faq-item">
          <summary>Can you bring the robot to our school?</summary>
          <p>
            Usually yes. Email us with the date, the age group, and roughly how
            many students, and we will tell you what we can do. See the
            outreach page for what a visit normally involves.
          </p>
        </details>

        <details class="card faq-item">
          <summary>How does sponsorship work?</summary>
          <p>
            Tiers and benefits are on the sponsors page. Email us and we will
            send the full package, including logo placement mockups.
          </p>
        </details>

        <details class="card faq-item">
          <summary>Do you take part donations?</summary>
          <p>
            <span class="ph-tag">[Placeholder]</span> Say whether the team
            accepts in-kind donations of materials, machining time, or tools,
            and who to contact about it.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: var(--sp-6);
  }

  @media (min-width: 940px) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--sp-7);
      align-items: start;
    }
  }

  /* ── Channels ────────────────────────────────────────────────────── */

  .channels {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .channel {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    text-decoration: none;
    color: inherit;
  }

  .channel-static {
    cursor: default;
  }

  .channel-static:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--glass-border);
  }

  .channel-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(89, 149, 237, 0.16);
    color: var(--accent);
    transition:
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  a.channel:hover .channel-icon {
    background: var(--highlight);
    color: var(--ink-inverse);
  }

  .channel-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    min-width: 0; /* lets long addresses wrap instead of overflowing */
  }

  .channel-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .channel-value {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink);
    word-break: break-word;
  }

  a.channel:hover .channel-value {
    color: var(--highlight);
  }

  .channel-note {
    font-size: var(--step--1);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* ── Form ────────────────────────────────────────────────────────── */

  .form-card {
    padding: var(--sp-6);
  }

  @media (min-width: 768px) {
    .form-card {
      padding: var(--sp-7);
    }
  }

  .form-title {
    font-size: var(--step-2);
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .form-note {
    margin-top: var(--sp-2);
    margin-bottom: var(--sp-6);
    font-size: var(--step--1);
    line-height: 1.5;
  }

  .field {
    margin-bottom: var(--sp-5);
  }

  .field label {
    display: block;
    margin-bottom: var(--sp-2);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .optional {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-faint);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    /* 48px tall. Anything smaller is awkward to tap accurately. */
    min-height: 48px;
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    background: rgba(7, 15, 28, 0.5);
    color: var(--ink);
    /* 1rem exactly. iOS Safari zooms the whole page in when a focused
       input has text smaller than 16px, which is jarring mid-form. */
    font-size: 1rem;
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .field textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(89, 149, 237, 0.22);
  }

  /* Marks a field the script found empty on submit. */
  .field.invalid input,
  .field.invalid textarea {
    border-color: #ff8f6b;
  }

  .form-submit {
    width: 100%;
  }

  .form-status {
    margin-top: var(--sp-4);
    font-size: var(--step--1);
    min-height: 1.4em;
    color: var(--ink-muted);
  }

  .form-status.error {
    color: #ff8f6b;
  }

  .form-fallback {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* ── FAQ ─────────────────────────────────────────────────────────── */

  .faq {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .faq-item {
    padding: 0;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    color: var(--ink);
    list-style: none;
  }

  /* Hides the native disclosure triangle in Safari. */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* A plus sign that rotates into a minus when the item opens. */
  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--highlight);
    transition: transform var(--dur) var(--ease);
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 var(--sp-5) var(--sp-5);
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.7;
  }
</style>

<script>
  /*
   * Turns the form into a pre-filled email.
   *
   * `novalidate` is set on the form so the browser's own validation bubbles
   * do not fire; we handle it here instead, which lets the message live in
   * an aria-live region a screen reader will actually announce.
   */

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  // Written out rather than templated in, so this script stays a plain
  // static file with no server-rendered values inside it.
  const TEAM_EMAIL = 'bubblotics@gmail.com';

  if (form && status) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const org = String(data.get('org') ?? '').trim();
      const reason = String(data.get('reason') ?? 'Website enquiry');
      const message = String(data.get('message') ?? '').trim();

      // Clear any previous error marks before re-checking.
      form.querySelectorAll('.field').forEach((f) => f.classList.remove('invalid'));

      const missing: string[] = [];
      if (!name) {
        document.getElementById('cf-name')?.closest('.field')?.classList.add('invalid');
        missing.push('your name');
      }
      if (!message) {
        document.getElementById('cf-message')?.closest('.field')?.classList.add('invalid');
        missing.push('a message');
      }

      if (missing.length) {
        status.textContent = `Please add ${missing.join(' and ')}.`;
        status.classList.add('error');
        form.querySelector<HTMLElement>('.field.invalid input, .field.invalid textarea')?.focus();
        return;
      }

      status.classList.remove('error');

      const subject = `${reason} — ${name}${org ? ` (${org})` : ''}`;
      const body = `${message}\n\n—\n${name}${org ? `\n${org}` : ''}`;

      // encodeURIComponent escapes line breaks, ampersands, and anything
      // else that would otherwise truncate the mailto link.
      const href =
        `mailto:${TEAM_EMAIL}` +
        `?subject=${encodeURIComponent(subject)}` +
        `&body=${encodeURIComponent(body)}`;

      window.location.href = href;

      status.textContent =
        'Opening your email app. If nothing happened, write to ' +
        TEAM_EMAIL +
        ' directly.';
    });
  }
</script>
