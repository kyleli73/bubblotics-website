---
/*
 * Documentation index.
 *
 * Guides for the tools the team runs. Separate from /software/, which is the
 * outward-facing "here is what we built" page: this is the inward-facing
 * "here is how to use it at 8am on match day" page.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/paths';

const guides = (await getCollection('docs', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Documentation"
  description="Guides for the tools Bubblotics runs: the scouting app and the parts inventory."
>
  <PageHero
    eyebrow="Documentation"
    title="How to use <span class='accent-word'>our tools</span>"
    lead="Guides for the apps the team runs at competitions and in the shop. Written for someone opening them for the first time."
  />

  <section class="section section-tight">
    <div class="shell">
      <div class="grid grid-2" data-reveal data-stagger>
        {
          guides.map((g, i) => (
            <article class="card card-link doc">
              <span class="doc-num">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="card-title">
                <a href={url(`/docs/${g.id}/`)} class="stretched">
                  {g.data.title}
                </a>
              </h2>
              <p class="doc-app">{g.data.app}</p>
              <p class="doc-summary">{g.data.summary}</p>
              <span class="link-arrow doc-cta">
                Read the guide
                <Icon name="arrow" size={16} />
              </span>
            </article>
          ))
        }
      </div>

      <p class="doc-note faint" data-reveal="fade">
        Join codes and passwords are deliberately not published on these
        pages. Ask a stand manager or a mentor.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .doc {
    display: flex;
    flex-direction: column;
    padding-top: var(--sp-6);
  }

  .doc-num {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1;
    color: rgba(89, 149, 237, 0.18);
  }

  .stretched {
    color: inherit;
    text-decoration: none;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .card-title {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .doc-app {
    margin-top: var(--sp-2);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .doc-summary {
    margin-top: var(--sp-4);
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
  }

  .doc-cta {
    margin-top: auto;
    padding-top: var(--sp-5);
  }

  .doc-note {
    margin-top: var(--sp-6);
    font-size: var(--step--1);
  }
</style>
