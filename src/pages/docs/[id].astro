---
/*
 * One documentation guide.
 *
 * Long-form and heavy on tables, so it uses the narrow reading measure and
 * the shared .prose styles rather than the wide marketing layout.
 */

import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bubbles from '../../components/Bubbles.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/paths';
import { contact } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('docs', ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

interface Props {
  guide: CollectionEntry<'docs'>;
}

const { guide } = Astro.props;
const d = guide.data;
const { Content } = await render(guide);
---

<BaseLayout title={d.title} description={d.summary}>
  <article>
    <header class="doc-head">
      <Bubbles count={8} tone="subtle" />
      <div class="shell shell-narrow doc-head-inner">
        <a href={url('/docs/')} class="back-link">
          <Icon name="arrow" size={15} class="back-arrow" />
          All guides
        </a>

        <p class="eyebrow" data-reveal="fade">
          {d.app}{d.revision ? ` · ${d.revision}` : ''}
        </p>
        <h1 data-reveal>{d.title}</h1>
        <p class="lead" data-reveal data-reveal-delay="0.08">{d.summary}</p>

        {
          d.appUrl && (
            <a
              href={d.appUrl}
              class="btn btn-primary btn-sm doc-open"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open the app
              <Icon name="arrowUpRight" size={15} />
            </a>
          )
        }
      </div>
    </header>

    <div class="section section-tight">
      <div class="shell shell-narrow">
        <div class="prose doc-prose">
          <Content />
        </div>

        <hr class="rule doc-rule" />

        <p class="doc-foot">
          Something in here wrong or out of date? Tell us at
          <a href={`mailto:${contact.email}`}>{contact.email}</a>.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .doc-head {
    position: relative;
    padding-top: calc(var(--header-h) + var(--sp-7));
    padding-bottom: var(--sp-5);
    overflow: hidden;
  }

  .doc-head-inner {
    position: relative;
    z-index: 1;
  }

  .doc-head h1 {
    font-size: var(--step-4);
    text-transform: none;
    letter-spacing: -0.02em;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-5);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--highlight);
  }

  .back-link :global(.back-arrow) {
    transform: rotate(180deg);
    transition: transform var(--dur) var(--ease);
  }

  .back-link:hover :global(.back-arrow) {
    transform: rotate(180deg) translateX(4px);
  }

  .doc-open {
    margin-top: var(--sp-5);
  }

  /* Guides lean on tables far more than the marketing pages do. */
  .doc-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-block: var(--sp-5);
    display: block;
    overflow-x: auto;
  }

  .doc-prose :global(th),
  .doc-prose :global(td) {
    text-align: left;
    padding: var(--sp-3);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .doc-prose :global(th) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border-bottom-color: var(--line-strong);
    white-space: nowrap;
  }

  .doc-prose :global(h1) {
    font-size: var(--step-2);
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line-strong);
    color: var(--ink);
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .doc-rule {
    margin-block: var(--sp-7);
  }

  .doc-foot {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
</style>
