---
/*
 * About / Our Story.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import StatStrip from '../components/StatStrip.astro';
import { team, subteams } from '../data/site';
import { SHOW_UNFINISHED, publishable } from '../lib/publish';

const timeline = [
  {
    year: 'Before us',
    title: 'SolversMind Robotics',
    body: '"Coach Dahai Zhang promotes first-principles thinking throughout SolversMind training."',
    quote: true,
    quoteSource: 'https://solversmind.ca/ourmission',
  },
  {
    year: 'September 2026',
    title: 'BIOBUZZ kickoff and CAD',
    body: null,
  },
  {
    year: 'November 8, 2026',
    title: 'North York Qualifier',
    body: null,
  },
];

---

<BaseLayout title="Our Story">
  <PageHero
    eyebrow="Our story"
    title="More Than Robots®"
    lead={team.blurb}
  />

  <StatStrip />

  <!-- ═══ MISSION ════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="shell">
      <div class="mission">
        <div>
          <p class="eyebrow">Mission</p>
          <h2 data-reveal>We exist to promote and share our passion for engineering and STEM across our communities.</h2>
        </div>
        <div class="prose" data-reveal="left">
          <p>
            Everything is 100% student-built.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TIMELINE ═══════════════════════════════════════════════════ -->
  <section class="section">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Timeline</p>
        <h2 data-reveal>How we got here</h2>
        <p>
          Est. 2026
        </p>
      </div>

      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="timeline-item" data-reveal="left">
              <span class="timeline-year">{item.year}</span>
              <div class="timeline-body">
                <h3>{item.title}</h3>
                {item.body && item.quote ? (
                  <blockquote>
                    <p>{item.body}</p>
                    {item.quoteSource && (
                      <p class="quote-source">
                        <a href={item.quoteSource} target="_blank" rel="noopener noreferrer">
                          From SolversMind
                        </a>
                      </p>
                    )}
                  </blockquote>
                ) : item.body ? (
                  <p>{item.body}</p>
                ) : null}
              </div>
            </li>
          ))
        }
        <!-- Empty future entries -->
        <li class="timeline-item timeline-future" data-reveal="left" aria-hidden="true">
          <span class="timeline-year"></span>
          <div class="timeline-body"></div>
        </li>
        <li class="timeline-item timeline-future" data-reveal="left" aria-hidden="true">
          <span class="timeline-year"></span>
          <div class="timeline-body"></div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ SUBTEAMS ═══════════════════════════════════════════════════ -->
  <section class="section section-tight">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">Structure</p>
        <h2 data-reveal>Four subteams, <span class="accent-word">one robot</span></h2>
      </div>

      <div class="grid grid-4" data-reveal data-stagger>
        {
          subteams.map((s, i) => (
            <article class="card subteam-card">
              <span class="subteam-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p>{s.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ PHOTOS ═════════════════════════════════════════════════════ -->
  <section class="section section-tight">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">The team</p>
        {SHOW_UNFINISHED && (
          <h2 data-reveal>[PLACEHOLDER] Team photo heading</h2>
        )}
      </div>
      <Gallery limit={6} columns={3} />
    </div>
  </section>

  {SHOW_UNFINISHED && (
    <CtaBand
      eyebrow="Join or support"
      title="[PLACEHOLDER] Want in?"
      body="[PLACEHOLDER] Call to action for joining or supporting the team."
      primaryLabel="Contact us"
      primaryHref="/contact/"
      secondaryLabel="Sponsor the team"
      secondaryHref="/sponsors/"
    />
  )}
</BaseLayout>

<style>
  .mission {
    display: grid;
    gap: var(--sp-6);
  }

  @media (min-width: 900px) {
    .mission {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--sp-8);
    }
  }

  .value-card :global(svg) {
    color: var(--ink-inverse);
  }

  .value-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--highlight);
    margin-bottom: var(--sp-4);
    box-shadow: var(--glow-warm);
  }

  .value-card h3 {
    font-size: var(--step-1);
    margin-bottom: var(--sp-3);
  }

  .value-card p {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
  }

  /* ── Timeline ────────────────────────────────────────────────────── */

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  /* The vertical spine. Fades at both ends so it doesn't stop abruptly. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--line-strong) 8%,
      var(--line-strong) 92%,
      transparent
    );
  }

  @media (min-width: 760px) {
    .timeline::before {
      left: 148px;
    }
  }

  .timeline-item {
    position: relative;
    display: grid;
    gap: var(--sp-2);
    padding-left: var(--sp-7);
    padding-bottom: var(--sp-7);
  }

  @media (min-width: 760px) {
    .timeline-item {
      grid-template-columns: 130px 1fr;
      gap: var(--sp-8);
      padding-left: 0;
    }
  }

  /* The bubble marker on the spine. */
  .timeline-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--prussian-950);
    border: 0;
    box-shadow: 0 0 0 4px rgba(89, 149, 237, 0.14);
  }

  @media (min-width: 760px) {
    .timeline-item::before {
      left: 141px;
    }
  }

  .timeline-year {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    color: var(--highlight);
  }

  .timeline-body h3 {
    font-size: var(--step-1);
    margin-bottom: var(--sp-2);
  }

  .timeline-body p {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
    max-width: 60ch;
  }

  .timeline-body blockquote {
    margin: 0;
    padding: 0;
    border: none;
    font-style: italic;
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
    max-width: 60ch;
  }

  .timeline-body blockquote p {
    margin: 0 0 var(--sp-3);
  }

  .quote-source {
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .quote-source a {
    color: var(--accent-soft);
  }

  .timeline-future {
    opacity: 0.3;
  }

  /* ── Subteams ────────────────────────────────────────────────────── */

  .subteam-card {
    padding-top: var(--sp-6);
  }

  .subteam-num {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-4);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1;
    color: rgba(89, 149, 237, 0.18);
  }

  .subteam-card h3 {
    font-size: var(--step-1);
    margin-bottom: var(--sp-3);
    color: var(--accent);
  }

  .subteam-card p {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }
</style>
