---
/*
 * The frame every page sits inside.
 *
 * A page never writes its own <html>, <head>, header, or footer. It supplies
 * a title and description, then its content as a slot. That is what keeps the
 * nav identical on all nine pages: it exists once, here.
 */

import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { team } from '../data/site';
import { url } from '../lib/paths';
import { logo, logoIsVector } from '../lib/brand';

interface Props {
  title: string;
  description?: string;
  /** Absolute or base-relative path to a link-preview image. */
  image?: string;
  /** Set on the home page so its <title> isn't "Bubblotics | Bubblotics". */
  bareTitle?: boolean;
}

const {
  title,
  description = team.metaDescription,
  image,
  bareTitle = false,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} | ${team.name} · Team ${team.number}`;

// Astro.site comes from `site` in astro.config.mjs. Social platforms need a
// full https:// URL for preview images, not a relative path.
const origin = Astro.site ?? 'http://localhost';
const canonical = new URL(Astro.url.pathname, origin);

/*
 * ── Favicon ────────────────────────────────────────────────────────────
 * Derived from the team logo rather than maintained as a separate file, so
 * there is no second copy to forget about when the logo changes.
 *
 * A raster logo is resized down to 64px at build time (a browser tab icon
 * renders at 16-32px, so anything larger is wasted bytes on every single
 * page load). An SVG is linked directly, since it scales on its own.
 *
 * With no logo added yet, this falls back to the placeholder in public/.
 */
const faviconHref = logo
  ? logoIsVector
    ? logo.src
    : (await getImage({ src: logo, width: 64, height: 64, format: 'png' })).src
  : url('/favicon.svg');

const faviconType = logo && logoIsVector ? 'image/svg+xml' : logo ? 'image/png' : 'image/svg+xml';

/*
 * ── Link preview image ─────────────────────────────────────────────────
 * What shows when someone shares a page in iMessage, Discord, or Slack. A
 * page can pass its own via the `image` prop; otherwise the logo stands in,
 * scaled to 1200x630, the size every social platform crops to.
 */
let previewImage: string | undefined;

if (image) {
  previewImage = new URL(url(image), origin).href;
} else if (logo && !logoIsVector) {
  const og = await getImage({ src: logo, width: 1200, height: 630, fit: 'contain', format: 'png' });
  previewImage = new URL(og.src, origin).href;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <!-- Generated from the team logo. See the note above. -->
    <link rel="icon" type={faviconType} href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />

    <!--
      Referrer policy, set here because GitHub Pages cannot send response
      headers and this is one of the few security controls a static page can
      genuinely set for itself. It stops the full URL of our pages leaking to
      third parties we link out to; they get the origin only.

      The rest of the usual set (HSTS, X-Frame-Options, X-Content-Type-Options)
      CANNOT be done this way. frame-ancestors and X-Frame-Options are ignored
      when they appear in a meta tag, so a meta CSP here would look like
      clickjacking protection while providing none, which is worse than
      nothing. Those need real headers, which means putting a proxy in front.
      See the README, "Security headers".
    -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- The browser chrome colour on mobile, matched to the page. -->
    <meta name="theme-color" content="#102542" />

    <!-- Link previews in iMessage, Discord, Instagram DMs, and Slack. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={team.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {previewImage && <meta property="og:image" content={previewImage} />}
    <meta
      name="twitter:card"
      content={previewImage ? 'summary_large_image' : 'summary'}
    />

    <!--
      Marks the document as JavaScript-capable BEFORE any CSS is applied.

      global.css hides [data-reveal] elements only under `.has-js`. If JS is
      disabled, blocked, or the bundle fails to download, this class is never
      added, the hiding rule never matches, and the visitor gets the full
      page with no animation. Without this guard the site would render blank
      for those people, which is the classic way to break a site with
      scroll animations and never find out.
    -->
    <script is:inline>
      document.documentElement.classList.add('has-js');
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!--
      Astro bundles, minifies, and fingerprints this for us. It loads as a
      module, which is deferred by default, so it never blocks the page from
      painting.
    -->
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
