---
/*
 * One blog post, as a card. Used on the Updates index and the home page teaser.
 */

import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { url, formatDate } from '../lib/paths';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'updates'>;
  /** Compact drops the image. Used in the home page teaser row. */
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const d = post.data;
const href = url(`/updates/${post.id}/`);
---

<article class:list={['card', 'card-link', 'update-card', { compact }]}>
  {
    !compact && (
      <div class="card-media">
        {d.coverImage ? (
          <Image
            src={d.coverImage}
            alt={d.coverImageAlt ?? ''}
            widths={[400, 800]}
            sizes="(min-width: 900px) 380px, 100vw"
            loading="lazy"
          />
        ) : (
          <div class="ph-image">
            <span>[Placeholder]</span>
            <small>Set `coverImage` in this post's markdown to add a photo.</small>
          </div>
        )}
      </div>
    )
  }

  <p class="update-meta">
    <Icon name="calendar" size={14} />
    <!-- datetime= gives the machine-readable form; the text is for people. -->
    <time datetime={d.date.toISOString().split('T')[0]}>
      {formatDate(d.date)}
    </time>
  </p>

  <h3 class="card-title">
    <a href={href} class="stretched">{d.title}</a>
  </h3>

  <p class="update-excerpt">{d.excerpt}</p>

  {
    d.tags.length > 0 && (
      <ul class="update-tags">
        {d.tags.map((t) => (
          <li class="tag">{t}</li>
        ))}
      </ul>
    )
  }

  <span class="link-arrow update-cta">
    Read more
    <Icon name="arrow" size={16} />
  </span>
</article>

<style>
  .update-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .stretched {
    color: inherit;
    text-decoration: none;
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .update-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-3);
  }

  .update-meta :global(svg) {
    color: var(--accent);
  }

  .card-title {
    font-size: var(--step-1);
    line-height: 1.25;
    margin-bottom: var(--sp-3);
  }

  .update-excerpt {
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.65;
  }

  .update-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
  }

  .update-cta {
    margin-top: auto;
    padding-top: var(--sp-5);
  }

  .compact .card-title {
    font-size: var(--step-1);
  }
</style>
