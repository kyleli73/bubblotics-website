---
/*
 * ═══════════════════════════════════════════════════════════════════════════
 *  HOLOGRAM CAD VIEWER
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Renders a robot's exported geometry as a translucent, glowing hologram you
 * can rotate, explode, and pick apart subsystem by subsystem.
 *
 * This is the "Tier 3" viewer. The Onshape embed (see the CAD section on the
 * robot page) is simpler and stays in sync with the live document by itself.
 * This one takes a static export, but in exchange it can be styled, lit, and
 * animated to match the site instead of showing Onshape's own interface.
 *
 * ── Adding a model ─────────────────────────────────────────────────────
 * Export the assembly from Onshape as glTF, save it to public/models/, and
 * point at it from the robot's markdown:
 *
 *     hologramModel: '/models/voyager.glb'
 *
 * The README has the full export walkthrough, including how to keep the file
 * small enough to be worth downloading.
 *
 * ── Performance ────────────────────────────────────────────────────────
 * Three.js is roughly 170 KB gzipped before any model data. Shipping that to
 * every visitor of every page, most of whom never scroll to a robot page,
 * would be indefensible. So both the library and the model load lazily, only
 * once this section is close to the viewport, via a dynamic import that Vite
 * splits into its own chunk.
 */

import Icon from './Icon.astro';
import { url } from '../lib/paths';

interface Props {
  /** Path under public/, e.g. '/models/voyager.glb'. */
  model: string;
  /** Robot name, used in labels and the accessible description. */
  name: string;
  caption?: string;
}

const { model, name, caption } = Astro.props;
---

<section class="section hologram-section" id="hologram">
  <div class="holo-ambience" aria-hidden="true"></div>

  <div class="shell">
    <div class="section-head">
      <p class="eyebrow" data-reveal="fade">
        <Icon name="cube" size={14} />
        Hologram
      </p>
      <h2 data-reveal>
        Take <span class="accent-word">{name}</span> apart
      </h2>
      <p data-reveal data-reveal-delay="0.06">
        The real assembly geometry, rendered as a hologram. Drag to orbit,
        scroll to zoom, and pull the subsystems apart to see how it goes
        together.
      </p>
    </div>

    <div
      class="holo"
      data-hologram
      data-model={model}
      data-name={name}
      data-draco={url('/draco/')}
      data-reveal="scale"
    >
      <!--
        The canvas is created by the script rather than written here, so a
        visitor whose JavaScript fails never sees an empty black rectangle
        where a robot should be. They get the message below instead.
      -->
      <div class="holo-stage" data-holo-stage>
        <div class="holo-status" data-holo-status>
          <span class="holo-spinner" aria-hidden="true"></span>
          <p data-holo-message>Preparing the hologram…</p>
        </div>

        <!--
          Callout overlay, in the style of an engineering drawing: a label in
          the margin, a thin leader line, and a dot on the part it names.

          Both layers are built by the script and repositioned every frame,
          because the anchor points are 3D positions projected to the screen.
          They have to move as the model rotates or the lines point at
          nothing.

          aria-hidden: the same information is in the numbered subsystem
          index below, which is real markup and reachable by keyboard. This
          is the decorative duplicate.
        -->
        <svg class="holo-leaders" data-holo-leaders aria-hidden="true"></svg>
        <div class="holo-callouts" data-holo-callouts aria-hidden="true"></div>

        <p class="holo-hint" data-holo-hint hidden>Drag &middot; Scroll &middot; Click a part</p>
      </div>

      <!-- Controls. Hidden until the model is actually loaded. -->
      <div class="holo-controls" data-holo-controls hidden>
        <div class="holo-group">
          <label class="holo-label" for="holo-explode">Exploded view</label>
          <input
            id="holo-explode"
            class="holo-range"
            type="range"
            min="0"
            max="100"
            value="0"
            data-holo-explode
          />
        </div>

        <div class="holo-actions">
          <button type="button" class="holo-btn" data-holo-reset>
            Reset view
          </button>
          <button
            type="button"
            class="holo-btn"
            data-holo-spin
            aria-pressed="true"
          >
            Pause spin
          </button>
        </div>
      </div>

      <!--
        Numbered subsystem index, filled in from the model's own part names.
        Numbered rather than a row of pills because this is meant to read as
        an engineering binder's parts list, and because the numbers tie each
        entry to its callout on the drawing above.
      -->
      <div class="holo-parts" data-holo-parts hidden>
        <p class="holo-parts-title">Subsystems</p>
        <ul data-holo-parts-list></ul>
      </div>
    </div>

    {caption && <p class="holo-caption">{caption}</p>}

    <p class="holo-note faint">
      Not loading? The model file may be missing, or WebGL may be unavailable
      on this device. The Onshape viewer above works either way.
    </p>
  </div>
</section>

<style>
  .hologram-section {
    position: relative;
    overflow: hidden;
  }

  /* The glow the hologram appears to cast into the page. */
  .holo-ambience {
    position: absolute;
    top: 10%;
    left: 50%;
    width: min(1200px, 130vw);
    aspect-ratio: 1.3;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse at 45% 45%, rgba(89, 149, 237, 0.26), transparent 60%),
      radial-gradient(ellipse at 62% 58%, rgba(255, 160, 0, 0.1), transparent 55%);
    filter: blur(12px);
    pointer-events: none;
    z-index: 0;
  }

  .hologram-section :global(.shell) {
    position: relative;
    z-index: 1;
  }

  .holo {
    position: relative;
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
    background:
      radial-gradient(ellipse at 50% 120%, rgba(89, 149, 237, 0.16), transparent 60%),
      rgba(7, 15, 28, 0.72);
    backdrop-filter: blur(var(--glass-blur));
    overflow: hidden;
    box-shadow: var(--shadow-lg), var(--glow);
  }

  .holo-stage {
    position: relative;
    width: 100%;
    /* Tall enough to actually manipulate a model on a laptop, capped so it
       never eats the whole screen on a phone. */
    height: clamp(360px, 62vh, 680px);
  }

  .holo-stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    /* grab / grabbing makes it obvious the thing is draggable. */
    cursor: grab;
    touch-action: none;
  }

  .holo-stage :global(canvas:active) {
    cursor: grabbing;
  }

  /* ── Loading and error states ────────────────────────────────────── */

  .holo-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-4);
    text-align: center;
    padding: var(--sp-5);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .holo-status[hidden] {
    display: none;
  }

  .holo-spinner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--line-strong);
    border-top-color: var(--accent);
    animation: holo-spin 900ms linear infinite;
  }

  @keyframes holo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .holo-spinner {
      animation: none;
      border-top-color: var(--line-strong);
    }
  }

  /* ── Callouts, engineering-drawing style ─────────────────────────── */

  .holo-leaders,
  .holo-callouts {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Above the canvas, below the loading state. */
    z-index: 2;
  }

  .holo-leaders {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The thin line from label to part, and the dot where it lands. */
  .holo-leaders :global(.leader) {
    fill: none;
    stroke: rgba(158, 208, 255, 0.42);
    stroke-width: 1;
    transition: stroke var(--dur-fast) var(--ease);
  }

  .holo-leaders :global(.leader-dot) {
    fill: none;
    stroke: rgba(158, 208, 255, 0.75);
    stroke-width: 1.25;
    transition:
      stroke var(--dur-fast) var(--ease),
      r var(--dur-fast) var(--ease);
  }

  /* Active is set from the subsystem index on hover or focus. */
  .holo-leaders :global(.is-active .leader),
  .holo-leaders :global(.is-active .leader-dot) {
    stroke: var(--highlight);
  }

  /*
   * :global is required on everything below. These elements are created by
   * the script, so they never receive Astro's data-astro-cid scoping
   * attribute, and a scoped selector would silently fail to match. The
   * symptom was a two-line callout rendering as one run-together line.
   */
  .holo-callouts :global(.holo-callout) {
    position: absolute;
    /* Positioned by transform from the script; top/left stay at 0 so the
       transform is the single source of truth for placement. */
    top: 0;
    left: 0;
    max-width: 190px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    transition: opacity var(--dur) var(--ease);
  }

  .holo-callouts :global(.holo-callout-num) {
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
  }

  .holo-callouts :global(.holo-callout-name) {
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .holo-callouts :global(.holo-callout.is-active .holo-callout-num),
  .holo-callouts :global(.holo-callout.is-active .holo-callout-name) {
    color: var(--highlight);
  }

  /* Callouts crowd badly on a narrow screen, and the model is small there
     anyway. The numbered index below carries the same information. */
  @media (max-width: 720px) {
    .holo-leaders,
    .holo-callouts {
      display: none;
    }
  }

  .holo-hint {
    position: absolute;
    left: 50%;
    bottom: var(--sp-4);
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .holo-hint[hidden] {
    display: none;
  }

  /* ── Controls ────────────────────────────────────────────────────── */

  .holo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    border-top: 1px solid var(--glass-border);
    background: rgba(7, 15, 28, 0.5);
  }

  .holo-controls[hidden] {
    display: none;
  }

  .holo-group {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: 1 1 260px;
  }

  .holo-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .holo-range {
    flex: 1;
    min-width: 120px;
    accent-color: var(--highlight);
    /* 44px tall hit area even though the track is thin. */
    height: 44px;
  }

  .holo-actions {
    display: flex;
    gap: var(--sp-2);
  }

  .holo-btn {
    min-height: 40px;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: rgba(89, 149, 237, 0.1);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .holo-btn:hover {
    background: var(--highlight);
    border-color: var(--highlight);
    color: var(--ink-inverse);
  }

  /* ── Subsystem list ──────────────────────────────────────────────── */

  .holo-parts {
    padding: var(--sp-4) var(--sp-5) var(--sp-5);
    border-top: 1px solid var(--glass-border);
  }

  .holo-parts[hidden] {
    display: none;
  }

  .holo-parts-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-3);
  }

  /* A parts list, not a row of chips: numbered rows in columns, the way an
     assembly drawing indexes its callouts. */
  .holo-parts ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 2px var(--sp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .holo-parts button {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    width: 100%;
    min-height: 36px;
    padding: var(--sp-2) var(--sp-2);
    text-align: left;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.03em;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .holo-parts :global(.holo-num) {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    flex-shrink: 0;
  }

  .holo-parts button:hover {
    color: var(--ink);
    border-bottom-color: var(--line-strong);
  }

  /* aria-pressed doubles as the styling hook, so the visual state and the
     state announced to a screen reader can never disagree. */
  .holo-parts button[aria-pressed='true'] {
    color: var(--highlight);
    border-bottom-color: var(--highlight);
  }

  .holo-parts button[aria-pressed='true'] :global(.holo-num) {
    color: var(--highlight);
  }

  .holo-caption {
    margin-top: var(--sp-4);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .holo-note {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
  }
</style>

<script>
  /*
   * ═══════════════════════════════════════════════════════════════════════
   *  HOLOGRAM RENDERER — point cloud
   * ═══════════════════════════════════════════════════════════════════════
   *
   * The robot is drawn as a cloud of glowing points plus a faint wireframe
   * of its edges, and it assembles itself: every point starts scattered on
   * a sphere around the model and flies to its real position, each one on a
   * slightly different clock so the shape resolves out of noise rather than
   * snapping into place.
   *
   * Why points instead of a shaded surface. A solid transparent mesh has to
   * choose between showing you the outside and showing you the inside, and
   * ends up doing neither well: overlapping faces pile up into a bright
   * soup. A point cloud is honestly sparse. You see straight through it to
   * the far side, the silhouette still reads, and depth comes from density
   * rather than from stacked transparency. It is also what actually looks
   * like a hologram, because a hologram is a projection of light rather
   * than a lit object.
   *
   * The points are sampled across triangle SURFACES, not taken from the
   * model's vertices. CAD geometry is mostly big flat panels: a few hundred
   * vertices bunched at corners. Using them directly gives a sparse cloud
   * that outlines corners and leaves the panels empty. Area-weighted
   * surface sampling spreads points evenly over the actual shape and is why
   * a 1,100-triangle export can still fill out as a dense cloud.
   *
   * Everything is one draw call for the points and one for the lines, so
   * the cost is in the vertex shader and is flat regardless of how the CAD
   * was modelled.
   */

  const roots = document.querySelectorAll<HTMLElement>('[data-hologram]');

  roots.forEach((root) => {
    let started = false;

    const launch = () => {
      if (started) return;
      started = true;
      io.disconnect();
      boot(root).catch((err) => {
        console.error('[hologram]', err);
        fail(root, 'The hologram could not be loaded.');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) launch();
      },
      { rootMargin: '400px' }
    );
    io.observe(root);

    /*
     * IntersectionObserver does not deliver callbacks while the document is
     * hidden, so a page opened in a background tab or restored from the
     * back-forward cache can sit on "Preparing the hologram…" with the
     * section plainly in view. A direct position check plus a
     * visibilitychange listener close that.
     */
    const near = () => {
      const r = root.getBoundingClientRect();
      return r.top < window.innerHeight + 400 && r.bottom > -400;
    };

    if (near()) launch();
    else {
      document.addEventListener('visibilitychange', function onVis() {
        if (!document.hidden && near()) {
          document.removeEventListener('visibilitychange', onVis);
          launch();
        }
      });
    }
  });

  function statusEls(root: HTMLElement) {
    return {
      status: root.querySelector<HTMLElement>('[data-holo-status]'),
      message: root.querySelector<HTMLElement>('[data-holo-message]'),
      spinner: root.querySelector<HTMLElement>('.holo-spinner'),
    };
  }

  function say(root: HTMLElement, text: string) {
    const m = statusEls(root).message;
    if (m) m.textContent = text;
  }

  function fail(root: HTMLElement, text: string) {
    const { message, spinner } = statusEls(root);
    if (message) message.textContent = text;
    if (spinner) spinner.remove();
  }

  async function boot(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-holo-stage]')!;
    const modelUrl = root.dataset.model!;
    const name = root.dataset.name ?? 'the robot';

    // Check WebGL before fetching ~170 KB of renderer.
    const probe = document.createElement('canvas');
    if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) {
      fail(root, 'This device does not support WebGL, so the hologram cannot render.');
      return;
    }

    say(root, 'Loading 3D engine…');

    const THREE = await import('three');
    const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
    const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
    const { DRACOLoader } = await import('three/examples/jsm/loaders/DRACOLoader.js');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const small = window.innerWidth < 760;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    /* ── Scene ─────────────────────────────────────────────────────── */
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      34,
      stage.clientWidth / stage.clientHeight,
      0.01,
      1000
    );

    const renderer = new THREE.WebGLRenderer({
      canvas: undefined,
      alpha: true,          // let the panel's own background show through
      antialias: !small,    // the cost is not worth it on a phone
      powerPreference: 'high-performance',
    });
    renderer.setClearColor(0x000000, 0);
    renderer.setSize(stage.clientWidth, stage.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    stage.appendChild(renderer.domElement);
    renderer.domElement.setAttribute(
      'aria-label',
      `Interactive 3D model of ${name}. Drag to rotate, scroll to zoom.`
    );

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.06;
    controls.enablePan = false;
    controls.autoRotate = !reduced;
    controls.autoRotateSpeed = 0.75;

    /* ── Load ──────────────────────────────────────────────────────── */
    say(root, 'Loading model…');

    const draco = new DRACOLoader();
    // No setDecoderConfig call: it is deprecated (removed in three r194) and
    // the wasm decoder is chosen automatically when the .wasm is present.
    draco.setDecoderPath(root.dataset.draco!);
    const loader = new GLTFLoader();
    loader.setDRACOLoader(draco);

    const gltf = await new Promise<any>((resolve, reject) => {
      loader.load(
        modelUrl,
        resolve,
        (evt) => {
          if (evt.total) {
            say(root, `Loading model… ${Math.round((evt.loaded / evt.total) * 100)}%`);
          }
        },
        () => reject(new Error(`Could not fetch ${modelUrl}.`))
      );
    });

    const model = gltf.scene as any;
    scene.add(model);
    model.updateMatrixWorld(true);

    /* ── Frame it ──────────────────────────────────────────────────── */
    const box = new THREE.Box3().setFromObject(model);
    const size = box.getSize(new THREE.Vector3());
    const centre = box.getCenter(new THREE.Vector3());
    const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;

    // Normalise to a unit-ish size so camera distance, point size, scatter
    // radius and repel strength behave the same for any export, whatever
    // units it happened to use.
    const scale = 1 / radius;
    model.position.sub(centre);
    model.scale.multiplyScalar(scale);
    model.position.multiplyScalar(scale);
    model.updateMatrixWorld(true);

    /*
     * Three-quarter view. A dead-on camera flattens the cloud into a slab,
     * because depth in a point cloud is read from parallax between near and
     * far points and there is none when everything is at the same distance.
     */
    const HOME = new THREE.Vector3(2.9, 1.7, 3.0);
    camera.position.copy(HOME);
    controls.target.set(0, 0, 0);
    controls.minDistance = 1.6;
    controls.maxDistance = 9;
    controls.update();

    /* ── Group meshes into subsystems ──────────────────────────────── */
    const meshes: any[] = [];
    model.traverse((c: any) => {
      if (c.isMesh) meshes.push(c);
    });

    const clean = (s: string) => {
      let n = (s || 'Part')
        .replace(/^occurrence of\s+/i, '')
        .replace(/_mesh$/, '')
        .trim();
      // Three appends _1, _2 … to duplicate names. Two trailing
      // underscore-number groups means base plus dedupe index.
      n = n.replace(/^(.+_\d+)_\d+$/, '$1');
      return n.replace(/_/g, ' ').trim();
    };

    const groupBy = (fn: (n: string) => string) => {
      const map = new Map<string, any[]>();
      for (const m of meshes) {
        const key = fn(clean(m.name)) || 'Part';
        if (!map.has(key)) map.set(key, []);
        map.get(key)!.push(m);
      }
      return map;
    };

    const byToken = groupBy((n) => n.split(/[-_.\s]/)[0]);
    const chosen = byToken.size >= 2 ? byToken : groupBy((n) => n);

    const parts: { name: string; objects: any[] }[] = [];
    for (const [pname, objects] of chosen) parts.push({ name: pname, objects });

    // Which subsystem each mesh belongs to, for tagging sampled points.
    const sysOf = new Map<any, number>();
    parts.forEach((p, i) => p.objects.forEach((o) => sysOf.set(o, i)));

    /* ── Sample points across the surfaces ─────────────────────────── */
    say(root, 'Building point cloud…');

    const TARGET = small ? 16000 : 44000;

    type Tri = { a: any; b: any; c: any; area: number; sys: number };
    const tris: Tri[] = [];
    let totalArea = 0;

    const vA = new THREE.Vector3();
    const vB = new THREE.Vector3();
    const vC = new THREE.Vector3();
    const ab = new THREE.Vector3();
    const ac = new THREE.Vector3();

    for (const mesh of meshes) {
      const geo = mesh.geometry;
      const pos = geo.attributes.position;
      if (!pos) continue;
      const idx = geo.index;
      const count = idx ? idx.count : pos.count;
      const sys = sysOf.get(mesh) ?? 0;

      for (let i = 0; i < count; i += 3) {
        const i0 = idx ? idx.getX(i) : i;
        const i1 = idx ? idx.getX(i + 1) : i + 1;
        const i2 = idx ? idx.getX(i + 2) : i + 2;

        vA.fromBufferAttribute(pos, i0).applyMatrix4(mesh.matrixWorld);
        vB.fromBufferAttribute(pos, i1).applyMatrix4(mesh.matrixWorld);
        vC.fromBufferAttribute(pos, i2).applyMatrix4(mesh.matrixWorld);

        ab.subVectors(vB, vA);
        ac.subVectors(vC, vA);
        const area = ab.cross(ac).length() * 0.5;
        if (!(area > 0)) continue;

        tris.push({ a: vA.clone(), b: vB.clone(), c: vC.clone(), area, sys });
        totalArea += area;
      }
    }

    if (!tris.length) {
      fail(root, 'The model contains no geometry to display.');
      return;
    }

    const positions = new Float32Array(TARGET * 3);
    const scatter = new Float32Array(TARGET * 3);
    const rands = new Float32Array(TARGET);
    const systems = new Float32Array(TARGET);

    // Deterministic PRNG so the cloud is identical on every load. A cloud
    // that reshuffles on refresh looks like a glitch, not a design.
    let seed = 20260803;
    const rnd = () => {
      seed = (seed * 1664525 + 1013904223) >>> 0;
      return seed / 4294967296;
    };

    // Walk the triangles once, giving each a share of the points in
    // proportion to its area, so big panels get filled and slivers do not
    // hog the budget.
    let placed = 0;
    for (const t of tris) {
      const share = Math.round((t.area / totalArea) * TARGET);
      for (let s = 0; s < share && placed < TARGET; s++) {
        // Uniform point in a triangle: the sqrt keeps them from bunching
        // toward one corner, which a naive pair of randoms would do.
        let u = rnd();
        let v = rnd();
        const su = Math.sqrt(u);
        const w0 = 1 - su;
        const w1 = su * (1 - v);
        const w2 = su * v;

        const o = placed * 3;
        positions[o] = t.a.x * w0 + t.b.x * w1 + t.c.x * w2;
        positions[o + 1] = t.a.y * w0 + t.b.y * w1 + t.c.y * w2;
        positions[o + 2] = t.a.z * w0 + t.b.z * w1 + t.c.z * w2;

        // Scattered start: a random point on a shell around the model.
        const theta = rnd() * Math.PI * 2;
        const phi = Math.acos(2 * rnd() - 1);
        const rr = 2.2 + rnd() * 2.2;
        scatter[o] = Math.sin(phi) * Math.cos(theta) * rr;
        scatter[o + 1] = Math.sin(phi) * Math.sin(theta) * rr;
        scatter[o + 2] = Math.cos(phi) * rr;

        rands[placed] = rnd();
        systems[placed] = t.sys;
        placed++;
      }
      if (placed >= TARGET) break;
    }

    // Rounding the per-triangle shares usually leaves a few slots short.
    // Fill them from the largest triangle rather than shipping zeroed
    // points, which would all sit at the origin as a bright dot.
    const biggest = tris.reduce((m, t) => (t.area > m.area ? t : m), tris[0]);
    while (placed < TARGET) {
      const su = Math.sqrt(rnd());
      const v = rnd();
      const w0 = 1 - su, w1 = su * (1 - v), w2 = su * v;
      const o = placed * 3;
      positions[o] = biggest.a.x * w0 + biggest.b.x * w1 + biggest.c.x * w2;
      positions[o + 1] = biggest.a.y * w0 + biggest.b.y * w1 + biggest.c.y * w2;
      positions[o + 2] = biggest.a.z * w0 + biggest.b.z * w1 + biggest.c.z * w2;
      const theta = rnd() * Math.PI * 2;
      const phi = Math.acos(2 * rnd() - 1);
      const rr = 2.2 + rnd() * 2.2;
      scatter[o] = Math.sin(phi) * Math.cos(theta) * rr;
      scatter[o + 1] = Math.sin(phi) * Math.sin(theta) * rr;
      scatter[o + 2] = Math.cos(phi) * rr;
      rands[placed] = rnd();
      systems[placed] = biggest.sys;
      placed++;
    }

    /* ── Per-subsystem explode directions ──────────────────────────── */
    const MAX_SYS = 24;
    const explodeDirs: any[] = [];
    for (let i = 0; i < MAX_SYS; i++) explodeDirs.push(new THREE.Vector3());
    parts.slice(0, MAX_SYS).forEach((p, i) => {
      const b = new THREE.Box3();
      p.objects.forEach((o: any) => b.expandByObject(o));
      const c = b.getCenter(new THREE.Vector3());
      if (c.lengthSq() === 0) c.set(0, 1, 0);
      explodeDirs[i] = c.normalize();
    });

    /* ── Shared shader chunks ──────────────────────────────────────── */
    const COMMON = /* glsl */ `
      uniform float uProgress;
      uniform float uTime;
      uniform vec2  uMouse;
      uniform float uRepel;
      uniform float uHoverMix;
      uniform float uExplode;
      uniform vec3  uExplodeDir[${MAX_SYS}];
      attribute vec3  aScatter;
      attribute float aRand;
      attribute float aSys;

      /*
       * Fly each point in from its scattered start. Subtracting aRand from
       * uProgress staggers the arrivals, so the shape resolves gradually
       * instead of every point landing on the same frame. The cubic ease
       * makes them decelerate as they arrive.
       */
      vec3 assembled(vec3 base) {
        vec3 target = base + uExplodeDir[int(aSys)] * uExplode;
        float t = clamp((uProgress - aRand * 0.38) / 0.62, 0.0, 1.0);
        float e = 1.0 - pow(1.0 - t, 3.0);
        vec3 p = mix(aScatter, target, e);

        // Never completely still: a hologram that freezes looks like a
        // screenshot. Damped while a subsystem is highlighted so the
        // thing being inspected holds still.
        p += 0.004 * (1.0 - uHoverMix * 0.8) * vec3(
          sin(uTime * 0.9 + aRand * 31.4),
          cos(uTime * 1.1 + aRand * 17.2),
          sin(uTime * 0.7 + aRand * 23.9)
        ) * (0.3 + 0.7 * aRand);
        return p;
      }

      /*
       * Push points away from the cursor, in clip space so the effect is a
       * constant size on screen regardless of zoom. Multiplying by
       * clipPos.w keeps the displacement from being scaled by the
       * perspective divide.
       */
      vec4 repelled(vec4 clipPos) {
        vec2 ndc = clipPos.xy / clipPos.w;
        vec2 d = ndc - uMouse;
        float push = smoothstep(0.24, 0.0, length(d)) * uRepel * (1.0 - uHoverMix * 0.7);
        clipPos.xy += normalize(d + 1e-5) * push * clipPos.w * 0.018;
        return clipPos;
      }
    `;

    const uniforms: any = {
      uProgress: { value: reduced ? 1 : 0 },
      uTime: { value: 0 },
      uMouse: { value: new THREE.Vector2(10, 10) },
      uRepel: { value: finePointer && !reduced ? 1 : 0 },
      uHoverMix: { value: 0 },
      uHover: { value: -1 },
      uExplode: { value: 0 },
      uExplodeDir: { value: explodeDirs },
      uSize: { value: small ? 1.3 : 1.7 },
      uPxRatio: { value: Math.min(window.devicePixelRatio, 2) },
      // Bright Snow and Cornflower Blue from the branding guide, so the
      // hologram is unmistakably ours rather than a borrowed palette.
      uInk: { value: new THREE.Color('#FCFAF9') },
      uAccent: { value: new THREE.Color('#5995ED') },
      uWarm: { value: new THREE.Color('#FFA101') },
      uOpacity: { value: 1.0 },
    };

    const pointsMaterial = new THREE.ShaderMaterial({
      uniforms,
      vertexShader: COMMON + /* glsl */ `
        uniform float uSize;
        uniform float uPxRatio;
        uniform float uHover;
        varying float vRand;
        varying float vDepth;
        varying float vHi;

        void main() {
          vRand = aRand;
          vHi = (uHover > -0.5 && abs(aSys - uHover) < 0.5) ? 1.0 : 0.0;
          vec4 mv = modelViewMatrix * vec4(assembled(position), 1.0);
          // Normalised distance, used to fade the far side of the cloud.
          vDepth = clamp((-mv.z - 2.2) / 3.4, 0.0, 1.0);
          gl_Position = repelled(projectionMatrix * mv);
          float s = uSize * (1.0 + vHi * uHoverMix * 0.55);
          gl_PointSize = s * uPxRatio * (2.6 / -mv.z) * (0.65 + 0.7 * aRand);
        }
      `,
      fragmentShader: /* glsl */ `
        precision highp float;
        uniform vec3  uInk;
        uniform vec3  uAccent;
        uniform vec3  uWarm;
        uniform float uOpacity;
        uniform float uHoverMix;
        varying float vRand;
        varying float vDepth;
        varying float vHi;

        void main() {
          // Round the square point sprite off, with a soft edge.
          vec2 c = gl_PointCoord - 0.5;
          float d = length(c);
          if (d > 0.5) discard;
          float edge = smoothstep(0.5, 0.30, d);

          // Mostly white, a scattering of blue, a rare fleck of orange.
          // Sparse on purpose: a uniformly coloured cloud reads as flat.
          vec3 col = mix(uInk, uAccent, step(0.80, vRand));
          col = mix(col, uWarm, step(0.975, vRand));
          col = mix(col, uAccent, vHi * uHoverMix);

          // Far points fade, which is what gives the cloud its volume.
          float alpha = uOpacity * mix(1.0, 0.45, vDepth);
          // While a subsystem is highlighted, everything else recedes.
          alpha *= mix(1.0, 0.28, uHoverMix * (1.0 - vHi));
          alpha = mix(alpha, 0.95, vHi * uHoverMix * (1.0 - vDepth * 0.5));

          gl_FragColor = vec4(col, alpha * edge);
        }
      `,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });

    const cloudGeo = new THREE.BufferGeometry();
    cloudGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    cloudGeo.setAttribute('aScatter', new THREE.BufferAttribute(scatter, 3));
    cloudGeo.setAttribute('aRand', new THREE.BufferAttribute(rands, 1));
    cloudGeo.setAttribute('aSys', new THREE.BufferAttribute(systems, 1));
    const cloud = new THREE.Points(cloudGeo, pointsMaterial);
    cloud.frustumCulled = false; // the shader moves points outside the box
    scene.add(cloud);

    /* ── Edge wireframe ────────────────────────────────────────────── */
    /*
     * Faint lines along the model's hard edges. The cloud alone reads as a
     * fog; the edges give it a silhouette and make panels legible as
     * panels. Deliberately dim, at about a sixth of the cloud's opacity:
     * turn them up and it stops being a hologram and becomes a wireframe.
     */
    const edgePos: number[] = [];
    const edgeScatter: number[] = [];
    const edgeRand: number[] = [];
    const edgeSys: number[] = [];

    for (const mesh of meshes) {
      const sys = sysOf.get(mesh) ?? 0;
      const edges = new THREE.EdgesGeometry(mesh.geometry, 28);
      const ep = edges.attributes.position;
      const v = new THREE.Vector3();
      for (let i = 0; i < ep.count; i++) {
        v.fromBufferAttribute(ep, i).applyMatrix4(mesh.matrixWorld);
        edgePos.push(v.x, v.y, v.z);
        const theta = rnd() * Math.PI * 2;
        const phi = Math.acos(2 * rnd() - 1);
        const rr = 2.2 + rnd() * 2.2;
        edgeScatter.push(
          Math.sin(phi) * Math.cos(theta) * rr,
          Math.sin(phi) * Math.sin(theta) * rr,
          Math.cos(phi) * rr
        );
        edgeRand.push(rnd());
        edgeSys.push(sys);
      }
      edges.dispose();
    }

    let lines: any = null;
    if (edgePos.length) {
      const lineUniforms = { ...uniforms, uOpacity: { value: 0.22 } };
      const lineMat = new THREE.ShaderMaterial({
        uniforms: lineUniforms,
        vertexShader: COMMON + /* glsl */ `
          uniform float uHover;
          varying float vDepth;
          varying float vHi;
          void main() {
            vHi = (uHover > -0.5 && abs(aSys - uHover) < 0.5) ? 1.0 : 0.0;
            vec4 mv = modelViewMatrix * vec4(assembled(position), 1.0);
            vDepth = clamp((-mv.z - 2.2) / 3.4, 0.0, 1.0);
            gl_Position = repelled(projectionMatrix * mv);
          }
        `,
        fragmentShader: /* glsl */ `
          // highp, not mediump: uHoverMix, uTime and friends are shared with
          // the vertex stage, and a uniform declared at two different
          // precisions makes the program fail to link. The symptom was
          // "Precisions of uniform 'uHoverMix' differ" and a silent fallback.
          precision highp float;
          uniform vec3  uInk;
          uniform vec3  uAccent;
          uniform float uOpacity;
          uniform float uHoverMix;
          varying float vDepth;
          varying float vHi;
          void main() {
            vec3 col = mix(uInk, uAccent, vHi * uHoverMix);
            float alpha = uOpacity * mix(1.0, 0.25, vDepth);
            alpha *= mix(1.0, 0.3, uHoverMix * (1.0 - vHi));
            alpha = mix(alpha, uOpacity * 3.0, vHi * uHoverMix);
            gl_FragColor = vec4(col, alpha);
          }
        `,
        transparent: true,
        depthWrite: false,
        blending: THREE.AdditiveBlending,
      });

      const lg = new THREE.BufferGeometry();
      lg.setAttribute('position', new THREE.BufferAttribute(new Float32Array(edgePos), 3));
      lg.setAttribute('aScatter', new THREE.BufferAttribute(new Float32Array(edgeScatter), 3));
      lg.setAttribute('aRand', new THREE.BufferAttribute(new Float32Array(edgeRand), 1));
      lg.setAttribute('aSys', new THREE.BufferAttribute(new Float32Array(edgeSys), 1));
      lines = new THREE.LineSegments(lg, lineMat);
      lines.frustumCulled = false;
      scene.add(lines);
      // Keep the line opacity in step with the cloud's when it changes.
      (lines as any).__uniforms = lineUniforms;
    }

    /*
     * The original meshes stay in the scene but invisible. They are still
     * the source of truth for where each subsystem is, which is what the
     * callout leaders point at, and they move when the exploded view does.
     */
    meshes.forEach((m) => (m.visible = false));

    /* ── Ready ─────────────────────────────────────────────────────── */
    statusEls(root).status!.hidden = true;
    const controlsEl = root.querySelector<HTMLElement>('[data-holo-controls]')!;
    const partsEl = root.querySelector<HTMLElement>('[data-holo-parts]')!;
    controlsEl.hidden = false;
    root.querySelector<HTMLElement>('[data-holo-hint]')!.hidden = false;

    // The assemble animation. Skipped entirely under reduced motion, where
    // uProgress starts at 1 and the model is simply there.
    if (!reduced) {
      const t0 = performance.now();
      const DUR = 2400;
      const tick = () => {
        const p = Math.min(1, (performance.now() - t0) / DUR);
        // Matches the site's easing elsewhere: quick start, long settle.
        uniforms.uProgress.value = p < 0.5
          ? 4 * p * p * p
          : 1 - Math.pow(-2 * p + 2, 3) / 2;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }

    /* ── Callouts ──────────────────────────────────────────────────── */
    const leadersSvg = root.querySelector<SVGSVGElement>('[data-holo-leaders]')!;
    const calloutLayer = root.querySelector<HTMLElement>('[data-holo-callouts]')!;
    const SVG_NS = 'http://www.w3.org/2000/svg';

    const callouts = parts.slice(0, 8).map((part, i) => {
      const group = document.createElementNS(SVG_NS, 'g');
      const line = document.createElementNS(SVG_NS, 'polyline');
      line.setAttribute('class', 'leader');
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('class', 'leader-dot');
      dot.setAttribute('r', '3');
      group.append(line, dot);
      leadersSvg.appendChild(group);

      const label = document.createElement('div');
      label.className = 'holo-callout';
      label.innerHTML =
        `<span class="holo-callout-num">${String(i + 1).padStart(2, '0')}</span>` +
        `<span class="holo-callout-name"></span>`;
      label.querySelector('.holo-callout-name')!.textContent = part.name;
      calloutLayer.appendChild(label);

      return { part, group, line, dot, label };
    });

    const projected = new THREE.Vector3();

    function layoutCallouts() {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      leadersSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);

      const points = callouts.map((c) => {
        const b = new THREE.Box3();
        c.part.objects.forEach((o: any) => b.expandByObject(o));
        b.getCenter(projected);
        const p = projected.project(camera);
        return {
          c,
          x: (p.x * 0.5 + 0.5) * w,
          y: (-p.y * 0.5 + 0.5) * h,
          behind: p.z > 1,
        };
      });

      // Even columns by horizontal rank, not by canvas half: an off-centre
      // model would otherwise stack every label into one column.
      const byX = [...points].sort((a, b) => a.x - b.x);
      const half = Math.ceil(byX.length / 2);
      const left = byX.slice(0, half).sort((a, b) => a.y - b.y);
      const right = byX.slice(half).sort((a, b) => a.y - b.y);

      const MARGIN = 14;
      const SLOT = 46;

      const place = (list: typeof points, side: 'left' | 'right') => {
        let top = Math.max(MARGIN, (h - list.length * SLOT) / 2);
        list.forEach((p) => {
          const labelW = 170;
          const x = side === 'left' ? MARGIN : w - MARGIN - labelW;
          const y = top;
          top += SLOT;

          p.c.label.style.transform = `translate(${x}px, ${y}px)`;
          p.c.label.style.width = `${labelW}px`;
          p.c.label.style.textAlign = side === 'left' ? 'left' : 'right';
          p.c.label.style.alignItems = side === 'left' ? 'flex-start' : 'flex-end';
          p.c.label.style.opacity = p.behind ? '0.25' : '1';
          p.c.group.style.opacity = p.behind ? '0.25' : '1';

          const startX = side === 'left' ? x + labelW * 0.02 : x + labelW;
          const startY = y + 22;
          const elbowX = side === 'left' ? startX + 28 : startX - 28;

          p.c.line.setAttribute(
            'points',
            `${startX},${startY} ${elbowX},${startY} ${p.x},${p.y}`
          );
          p.c.dot.setAttribute('cx', String(p.x));
          p.c.dot.setAttribute('cy', String(p.y));
        });
      };

      place(left, 'left');
      place(right, 'right');
    }

    const setCalloutActive = (index: number, on: boolean) => {
      const c = callouts[index];
      if (!c) return;
      c.label.classList.toggle('is-active', on);
      c.group.classList.toggle('is-active', on);
    };

    /* ── Highlighting a subsystem ──────────────────────────────────── */
    let hoverTarget = -1;
    const setHover = (index: number) => {
      hoverTarget = index;
      uniforms.uHover.value = index;
      if (lines) (lines as any).__uniforms.uHover.value = index;
    };

    /* ── Exploded view ─────────────────────────────────────────────── */
    const explodeInput = root.querySelector<HTMLInputElement>('[data-holo-explode]')!;
    const homes = new Map<any, any>();
    meshes.forEach((m) => homes.set(m, m.position.clone()));

    explodeInput.addEventListener('input', () => {
      const amount = (Number(explodeInput.value) / 100) * 1.1;
      uniforms.uExplode.value = amount;
      if (lines) (lines as any).__uniforms.uExplode.value = amount;
      // Move the invisible meshes too, so the callout leaders follow.
      meshes.forEach((m) => {
        const sys = sysOf.get(m) ?? 0;
        const dir = explodeDirs[Math.min(sys, MAX_SYS - 1)];
        m.position.copy(homes.get(m)).addScaledVector(dir, amount / (model.scale.x || 1));
      });
    });

    /* ── Reset ─────────────────────────────────────────────────────── */
    root.querySelector('[data-holo-reset]')!.addEventListener('click', () => {
      explodeInput.value = '0';
      explodeInput.dispatchEvent(new Event('input'));
      camera.position.copy(HOME);
      controls.target.set(0, 0, 0);
      controls.update();
      setHover(-1);
      partsEl
        .querySelectorAll<HTMLButtonElement>('button[aria-pressed="true"]')
        .forEach((b) => b.setAttribute('aria-pressed', 'false'));
    });

    /* ── Spin toggle ───────────────────────────────────────────────── */
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-holo-spin]')!;
    if (reduced) {
      spinBtn.setAttribute('aria-pressed', 'false');
      spinBtn.textContent = 'Start spin';
    }
    spinBtn.addEventListener('click', () => {
      controls.autoRotate = !controls.autoRotate;
      spinBtn.setAttribute('aria-pressed', String(controls.autoRotate));
      spinBtn.textContent = controls.autoRotate ? 'Pause spin' : 'Start spin';
    });

    // Stop auto-rotating as soon as someone takes hold of it. Fighting a
    // drag is the fastest way to make a viewer feel broken.
    controls.addEventListener('start', () => {
      if (controls.autoRotate) {
        controls.autoRotate = false;
        spinBtn.setAttribute('aria-pressed', 'false');
        spinBtn.textContent = 'Start spin';
      }
    });

    /* ── Subsystem index ───────────────────────────────────────────── */
    if (parts.length > 1) {
      const list = root.querySelector<HTMLElement>('[data-holo-parts-list]')!;
      partsEl.hidden = false;

      parts.forEach((part, partIndex) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.innerHTML =
          `<span class="holo-num">${String(partIndex + 1).padStart(2, '0')}</span><span></span>`;
        btn.lastElementChild!.textContent = part.name;
        btn.setAttribute('aria-pressed', 'false');

        const enter = () => {
          if (btn.getAttribute('aria-pressed') === 'true') return;
          setHover(partIndex);
          setCalloutActive(partIndex, true);
        };
        const leave = () => {
          if (btn.getAttribute('aria-pressed') === 'true') return;
          setHover(-1);
          setCalloutActive(partIndex, false);
        };

        btn.addEventListener('pointerenter', enter);
        btn.addEventListener('pointerleave', leave);
        btn.addEventListener('focus', enter);
        btn.addEventListener('blur', leave);

        // Click pins the highlight, so it survives the pointer leaving.
        btn.addEventListener('click', () => {
          const wasPinned = btn.getAttribute('aria-pressed') === 'true';
          list.querySelectorAll<HTMLButtonElement>('button').forEach((b, i) => {
            b.setAttribute('aria-pressed', 'false');
            setCalloutActive(i, false);
          });
          if (wasPinned) {
            setHover(-1);
          } else {
            btn.setAttribute('aria-pressed', 'true');
            setHover(partIndex);
            setCalloutActive(partIndex, true);
          }
        });

        li.appendChild(btn);
        list.appendChild(li);
      });
    }

    /* ── Pointer tracking for the repel effect ─────────────────────── */
    if (finePointer && !reduced) {
      renderer.domElement.addEventListener('pointermove', (e) => {
        const r = renderer.domElement.getBoundingClientRect();
        uniforms.uMouse.value.set(
          ((e.clientX - r.left) / r.width) * 2 - 1,
          -(((e.clientY - r.top) / r.height) * 2 - 1)
        );
      });
      renderer.domElement.addEventListener('pointerleave', () => {
        uniforms.uMouse.value.set(10, 10); // far outside, so nothing repels
      });
    }

    /* ── Render loop ───────────────────────────────────────────────── */
    // performance.now() rather than THREE.Clock, which is deprecated in
    // favour of THREE.Timer. One less thing to migrate, and no import.
    const startedAt = performance.now();
    let running = true;

    function frame() {
      if (!running) return;
      const t = (performance.now() - startedAt) / 1000;
      uniforms.uTime.value = t;

      // Ease the highlight in and out rather than snapping, so dimming the
      // rest of the model reads as a focus pull.
      const wantMix = hoverTarget >= 0 ? 1 : 0;
      uniforms.uHoverMix.value += (wantMix - uniforms.uHoverMix.value) * 0.12;
      if (lines) {
        const lu = (lines as any).__uniforms;
        lu.uTime.value = t;
        lu.uHoverMix.value = uniforms.uHoverMix.value;
        lu.uProgress.value = uniforms.uProgress.value;
        lu.uMouse.value.copy(uniforms.uMouse.value);
      }

      controls.update();
      renderer.render(scene, camera);
      layoutCallouts();
      requestAnimationFrame(frame);
    }
    frame();

    /* ── Pause when off screen or backgrounded ─────────────────────── */
    const visIO = new IntersectionObserver(
      (entries) => {
        const was = running;
        running = entries[0].isIntersecting && !document.hidden;
        if (running && !was) frame();
      },
      { threshold: 0 }
    );
    visIO.observe(root);

    document.addEventListener('visibilitychange', () => {
      const was = running;
      running = !document.hidden;
      if (running && !was) frame();
    });

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        camera.aspect = stage.clientWidth / stage.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(stage.clientWidth, stage.clientHeight);
        uniforms.uPxRatio.value = Math.min(window.devicePixelRatio, 2);
      }, 150);
    });
  }
</script>
