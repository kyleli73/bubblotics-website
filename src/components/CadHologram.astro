---
/*
 * ═══════════════════════════════════════════════════════════════════════════
 *  HOLOGRAM CAD VIEWER
 * ═══════════════════════════════════════════════════════════════════════════
 *
 * Renders a robot's exported geometry as a translucent, glowing hologram you
 * can rotate, explode, and pick apart subsystem by subsystem.
 *
 * This is the "Tier 3" viewer. The Onshape embed (see the CAD section on the
 * robot page) is simpler and stays in sync with the live document by itself.
 * This one takes a static export, but in exchange it can be styled, lit, and
 * animated to match the site instead of showing Onshape's own interface.
 *
 * ── Adding a model ─────────────────────────────────────────────────────
 * Export the assembly from Onshape as glTF, save it to public/models/, and
 * point at it from the robot's markdown:
 *
 *     hologramModel: '/models/voyager.glb'
 *
 * The README has the full export walkthrough, including how to keep the file
 * small enough to be worth downloading.
 *
 * ── Performance ────────────────────────────────────────────────────────
 * Three.js is roughly 170 KB gzipped before any model data. Shipping that to
 * every visitor of every page, most of whom never scroll to a robot page,
 * would be indefensible. So both the library and the model load lazily, only
 * once this section is close to the viewport, via a dynamic import that Vite
 * splits into its own chunk.
 */

import Icon from './Icon.astro';
import { url } from '../lib/paths';

interface Props {
  /** Path under public/, e.g. '/models/voyager.glb'. */
  model: string;
  /** Robot name, used in labels and the accessible description. */
  name: string;
  caption?: string;
}

const { model, name, caption } = Astro.props;
---

<section class="section hologram-section" id="hologram">
  <div class="holo-ambience" aria-hidden="true"></div>

  <div class="shell">
    <div class="section-head">
      <p class="eyebrow" data-reveal="fade">
        <Icon name="cube" size={14} />
        Hologram
      </p>
      <h2 data-reveal>
        Take <span class="accent-word">{name}</span> apart
      </h2>
      <p data-reveal data-reveal-delay="0.06">
        The real assembly geometry, rendered as a hologram. Drag to orbit,
        scroll to zoom, and pull the subsystems apart to see how it goes
        together.
      </p>
    </div>

    <div
      class="holo"
      data-hologram
      data-model={model}
      data-name={name}
      data-draco={url('/draco/')}
      data-reveal="scale"
    >
      <!--
        The canvas is created by the script rather than written here, so a
        visitor whose JavaScript fails never sees an empty black rectangle
        where a robot should be. They get the message below instead.
      -->
      <div class="holo-stage" data-holo-stage>
        <div class="holo-status" data-holo-status>
          <span class="holo-spinner" aria-hidden="true"></span>
          <p data-holo-message>Preparing the hologram…</p>
        </div>

        <!--
          Callout overlay, in the style of an engineering drawing: a label in
          the margin, a thin leader line, and a dot on the part it names.

          Both layers are built by the script and repositioned every frame,
          because the anchor points are 3D positions projected to the screen.
          They have to move as the model rotates or the lines point at
          nothing.

          aria-hidden: the same information is in the numbered subsystem
          index below, which is real markup and reachable by keyboard. This
          is the decorative duplicate.
        -->
        <svg class="holo-leaders" data-holo-leaders aria-hidden="true"></svg>
        <div class="holo-callouts" data-holo-callouts aria-hidden="true"></div>

        <p class="holo-hint" data-holo-hint hidden>Drag &middot; Scroll &middot; Click a part</p>
      </div>

      <!-- Controls. Hidden until the model is actually loaded. -->
      <div class="holo-controls" data-holo-controls hidden>
        <div class="holo-group">
          <label class="holo-label" for="holo-explode">Exploded view</label>
          <input
            id="holo-explode"
            class="holo-range"
            type="range"
            min="0"
            max="100"
            value="0"
            data-holo-explode
          />
        </div>

        <div class="holo-actions">
          <button type="button" class="holo-btn" data-holo-reset>
            Reset view
          </button>
          <button
            type="button"
            class="holo-btn"
            data-holo-spin
            aria-pressed="true"
          >
            Pause spin
          </button>
        </div>
      </div>

      <!--
        Numbered subsystem index, filled in from the model's own part names.
        Numbered rather than a row of pills because this is meant to read as
        an engineering binder's parts list, and because the numbers tie each
        entry to its callout on the drawing above.
      -->
      <div class="holo-parts" data-holo-parts hidden>
        <p class="holo-parts-title">Subsystems</p>
        <ul data-holo-parts-list></ul>
      </div>
    </div>

    {caption && <p class="holo-caption">{caption}</p>}

    <p class="holo-note faint">
      Not loading? The model file may be missing, or WebGL may be unavailable
      on this device. The Onshape viewer above works either way.
    </p>
  </div>
</section>

<style>
  .hologram-section {
    position: relative;
    overflow: hidden;
  }

  /* The glow the hologram appears to cast into the page. */
  .holo-ambience {
    position: absolute;
    top: 10%;
    left: 50%;
    width: min(1200px, 130vw);
    aspect-ratio: 1.3;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse at 45% 45%, rgba(89, 149, 237, 0.26), transparent 60%),
      radial-gradient(ellipse at 62% 58%, rgba(255, 160, 0, 0.1), transparent 55%);
    filter: blur(12px);
    pointer-events: none;
    z-index: 0;
  }

  .hologram-section :global(.shell) {
    position: relative;
    z-index: 1;
  }

  .holo {
    position: relative;
    border-radius: var(--radius-xl);
    border: 1px solid var(--glass-border);
    background:
      radial-gradient(ellipse at 50% 120%, rgba(89, 149, 237, 0.16), transparent 60%),
      rgba(7, 15, 28, 0.72);
    backdrop-filter: blur(var(--glass-blur));
    overflow: hidden;
    box-shadow: var(--shadow-lg), var(--glow);
  }

  .holo-stage {
    position: relative;
    width: 100%;
    /* Tall enough to actually manipulate a model on a laptop, capped so it
       never eats the whole screen on a phone. */
    height: clamp(360px, 62vh, 680px);
  }

  .holo-stage :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    /* grab / grabbing makes it obvious the thing is draggable. */
    cursor: grab;
    touch-action: none;
  }

  .holo-stage :global(canvas:active) {
    cursor: grabbing;
  }

  /* ── Loading and error states ────────────────────────────────────── */

  .holo-status {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-4);
    text-align: center;
    padding: var(--sp-5);
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .holo-status[hidden] {
    display: none;
  }

  .holo-spinner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--line-strong);
    border-top-color: var(--accent);
    animation: holo-spin 900ms linear infinite;
  }

  @keyframes holo-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .holo-spinner {
      animation: none;
      border-top-color: var(--line-strong);
    }
  }

  /* ── Callouts, engineering-drawing style ─────────────────────────── */

  .holo-leaders,
  .holo-callouts {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Above the canvas, below the loading state. */
    z-index: 2;
  }

  .holo-leaders {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* The thin line from label to part, and the dot where it lands. */
  .holo-leaders :global(.leader) {
    fill: none;
    stroke: rgba(158, 208, 255, 0.42);
    stroke-width: 1;
    transition: stroke var(--dur-fast) var(--ease);
  }

  .holo-leaders :global(.leader-dot) {
    fill: none;
    stroke: rgba(158, 208, 255, 0.75);
    stroke-width: 1.25;
    transition:
      stroke var(--dur-fast) var(--ease),
      r var(--dur-fast) var(--ease);
  }

  /* Active is set from the subsystem index on hover or focus. */
  .holo-leaders :global(.is-active .leader),
  .holo-leaders :global(.is-active .leader-dot) {
    stroke: var(--highlight);
  }

  /*
   * :global is required on everything below. These elements are created by
   * the script, so they never receive Astro's data-astro-cid scoping
   * attribute, and a scoped selector would silently fail to match. The
   * symptom was a two-line callout rendering as one run-together line.
   */
  .holo-callouts :global(.holo-callout) {
    position: absolute;
    /* Positioned by transform from the script; top/left stay at 0 so the
       transform is the single source of truth for placement. */
    top: 0;
    left: 0;
    max-width: 190px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    transition: opacity var(--dur) var(--ease);
  }

  .holo-callouts :global(.holo-callout-num) {
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--accent);
  }

  .holo-callouts :global(.holo-callout-name) {
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .holo-callouts :global(.holo-callout.is-active .holo-callout-num),
  .holo-callouts :global(.holo-callout.is-active .holo-callout-name) {
    color: var(--highlight);
  }

  /* Callouts crowd badly on a narrow screen, and the model is small there
     anyway. The numbered index below carries the same information. */
  @media (max-width: 720px) {
    .holo-leaders,
    .holo-callouts {
      display: none;
    }
  }

  .holo-hint {
    position: absolute;
    left: 50%;
    bottom: var(--sp-4);
    transform: translateX(-50%);
    z-index: 2;
    pointer-events: none;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .holo-hint[hidden] {
    display: none;
  }

  /* ── Controls ────────────────────────────────────────────────────── */

  .holo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    border-top: 1px solid var(--glass-border);
    background: rgba(7, 15, 28, 0.5);
  }

  .holo-controls[hidden] {
    display: none;
  }

  .holo-group {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: 1 1 260px;
  }

  .holo-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .holo-range {
    flex: 1;
    min-width: 120px;
    accent-color: var(--highlight);
    /* 44px tall hit area even though the track is thin. */
    height: 44px;
  }

  .holo-actions {
    display: flex;
    gap: var(--sp-2);
  }

  .holo-btn {
    min-height: 40px;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: rgba(89, 149, 237, 0.1);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .holo-btn:hover {
    background: var(--highlight);
    border-color: var(--highlight);
    color: var(--ink-inverse);
  }

  /* ── Subsystem list ──────────────────────────────────────────────── */

  .holo-parts {
    padding: var(--sp-4) var(--sp-5) var(--sp-5);
    border-top: 1px solid var(--glass-border);
  }

  .holo-parts[hidden] {
    display: none;
  }

  .holo-parts-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--sp-3);
  }

  /* A parts list, not a row of chips: numbered rows in columns, the way an
     assembly drawing indexes its callouts. */
  .holo-parts ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 2px var(--sp-4);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .holo-parts button {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    width: 100%;
    min-height: 36px;
    padding: var(--sp-2) var(--sp-2);
    text-align: left;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.03em;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .holo-parts :global(.holo-num) {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--accent);
    flex-shrink: 0;
  }

  .holo-parts button:hover {
    color: var(--ink);
    border-bottom-color: var(--line-strong);
  }

  /* aria-pressed doubles as the styling hook, so the visual state and the
     state announced to a screen reader can never disagree. */
  .holo-parts button[aria-pressed='true'] {
    color: var(--highlight);
    border-bottom-color: var(--highlight);
  }

  .holo-parts button[aria-pressed='true'] :global(.holo-num) {
    color: var(--highlight);
  }

  .holo-caption {
    margin-top: var(--sp-4);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .holo-note {
    margin-top: var(--sp-3);
    font-size: var(--step--1);
  }
</style>

<script>
  /*
   * Hologram viewer runtime.
   *
   * Everything below runs only when a [data-hologram] element scrolls near
   * the viewport, and imports Three.js dynamically at that moment so the
   * library never lands in the main bundle.
   */

  const roots = document.querySelectorAll<HTMLElement>('[data-hologram]');

  roots.forEach((root) => {
    let started = false;

    const launch = () => {
      if (started) return;
      started = true;
      io.disconnect();
      boot(root).catch((err) => {
        console.error('[hologram]', err);
        fail(root, 'The hologram could not be loaded.');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) launch();
      },
      // Start fetching a little before it is actually on screen, so the
      // model is often ready by the time the reader arrives.
      { rootMargin: '400px' }
    );

    io.observe(root);

    /*
     * Belt and braces: check the position directly as well.
     *
     * IntersectionObserver does not deliver callbacks while the document is
     * hidden, so a page opened in a background tab, restored from the
     * back-forward cache, or loaded with the window minimised can sit with
     * the viewer stuck on "Preparing the hologram…" even though the section
     * is plainly in view. This costs one layout read and removes that whole
     * class of failure.
     */
    const near = () => {
      const r = root.getBoundingClientRect();
      return r.top < window.innerHeight + 400 && r.bottom > -400;
    };

    if (near()) launch();
    else {
      // If it was not in view at load, re-check when the tab becomes
      // visible, for the same reason.
      document.addEventListener('visibilitychange', function onVis() {
        if (!document.hidden && near()) {
          document.removeEventListener('visibilitychange', onVis);
          launch();
        }
      });
    }
  });

  function statusEls(root: HTMLElement) {
    return {
      status: root.querySelector<HTMLElement>('[data-holo-status]'),
      message: root.querySelector<HTMLElement>('[data-holo-message]'),
      spinner: root.querySelector<HTMLElement>('.holo-spinner'),
    };
  }

  function say(root: HTMLElement, text: string) {
    statusEls(root).message!.textContent = text;
  }

  function fail(root: HTMLElement, text: string) {
    const { message, spinner } = statusEls(root);
    if (message) message.textContent = text;
    if (spinner) spinner.remove();
  }

  async function boot(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('[data-holo-stage]')!;
    const modelUrl = root.dataset.model!;
    const name = root.dataset.name ?? 'the robot';

    // WebGL can be missing entirely (old device, hardware acceleration off,
    // some locked-down school machines). Check before loading 170 KB.
    const probe = document.createElement('canvas');
    const hasWebGL = !!(
      probe.getContext('webgl2') || probe.getContext('webgl')
    );
    if (!hasWebGL) {
      fail(root, 'This device does not support WebGL, so the hologram cannot render.');
      return;
    }

    say(root, 'Loading 3D engine…');

    // Dynamic imports: these become their own chunks, fetched only here.
    const THREE = await import('three');
    const { OrbitControls } = await import(
      'three/examples/jsm/controls/OrbitControls.js'
    );
    const { GLTFLoader } = await import(
      'three/examples/jsm/loaders/GLTFLoader.js'
    );
    const { DRACOLoader } = await import(
      'three/examples/jsm/loaders/DRACOLoader.js'
    );

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Scene ─────────────────────────────────────────────────────── */
    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      42,
      stage.clientWidth / stage.clientHeight,
      0.01,
      1000
    );

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true, // let the panel's own background show through
      powerPreference: 'high-performance',
    });
    renderer.setSize(stage.clientWidth, stage.clientHeight);
    // Capped at 2 for the same reason as the bubbles: a 3x phone pays triple
    // the fragment cost for pixels nobody can distinguish.
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    stage.appendChild(renderer.domElement);
    renderer.domElement.setAttribute(
      'aria-label',
      `Interactive 3D model of ${name}. Drag to rotate, scroll to zoom.`
    );

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;       // momentum, so it feels weighted
    controls.dampingFactor = 0.06;
    controls.enablePan = false;          // panning mostly just loses the model
    controls.autoRotate = !reduced;
    controls.autoRotateSpeed = 0.9;

    // Two rim lights. The hologram material is mostly emissive, but a little
    // real lighting keeps the surfaces from reading as flat.
    scene.add(new THREE.AmbientLight(0x8fb6ff, 0.6));
    const key = new THREE.DirectionalLight(0xbcd8ff, 1.4);
    key.position.set(3, 5, 4);
    scene.add(key);
    const rim = new THREE.DirectionalLight(0xffa000, 0.7);
    rim.position.set(-4, -2, -3);
    scene.add(rim);

    /* ── The hologram material ─────────────────────────────────────────
       A Fresnel term is what sells it: surfaces facing you are nearly
       transparent, surfaces angled away glow at the edges. That is how you
       see a shape's silhouette and its internal structure at the same time,
       which is exactly the "hologram" read.

       Scanlines are added in world space rather than screen space so they sit
       on the object and travel with it as it rotates, instead of sliding
       across the screen like a filter laid on top. */
    const holoMaterial = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uCore: { value: new THREE.Color(0x2f6fbf) },
        uRim: { value: new THREE.Color(0x9ed0ff) },
        uAccent: { value: new THREE.Color(0xffa000) },
        uOpacity: { value: 1 },
      },
      vertexShader: /* glsl */ `
        varying vec3 vNormalW;
        varying vec3 vViewDir;
        varying vec3 vPosW;
        void main() {
          vec4 worldPos = modelMatrix * vec4(position, 1.0);
          vPosW = worldPos.xyz;
          vNormalW = normalize(mat3(modelMatrix) * normal);
          vViewDir = normalize(cameraPosition - worldPos.xyz);
          gl_Position = projectionMatrix * viewMatrix * worldPos;
        }
      `,
      fragmentShader: /* glsl */ `
        uniform float uTime;
        uniform vec3 uCore;
        uniform vec3 uRim;
        uniform vec3 uAccent;
        uniform float uOpacity;
        varying vec3 vNormalW;
        varying vec3 vViewDir;
        varying vec3 vPosW;

        void main() {
          vec3 n = normalize(vNormalW);
          // Two-sided: back faces are visible through the front, which is
          // what makes the internals readable.
          if (!gl_FrontFacing) n = -n;

          float fres = 1.0 - clamp(dot(n, normalize(vViewDir)), 0.0, 1.0);
          fres = pow(fres, 2.2);

          // Travelling scanline band, in world space so it rides the model.
          float scan = sin(vPosW.y * 90.0 - uTime * 2.2) * 0.5 + 0.5;
          scan = smoothstep(0.72, 1.0, scan) * 0.22;

          vec3 col = mix(uCore, uRim, fres);
          col += uAccent * scan;

          // Nearly clear head-on, bright at grazing angles.
          float alpha = (0.10 + fres * 0.85 + scan * 0.35) * uOpacity;

          gl_FragColor = vec4(col, clamp(alpha, 0.0, 1.0));
        }
      `,
      transparent: true,
      side: THREE.DoubleSide,
      // Without this, transparent surfaces hide the ones behind them and the
      // interior disappears, which defeats the whole effect.
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });

    /* ── Load the model ────────────────────────────────────────────── */
    say(root, 'Loading model…');

    /*
     * Draco support.
     *
     * Onshape exports with KHR_draco_mesh_compression turned on by default,
     * which is genuinely good: it is why a 3,000-triangle assembly is tens of
     * kilobytes rather than hundreds. But the browser cannot read it without
     * this decoder, and the failure is silent. GLTFLoader still builds the
     * scene graph, so the part names and the controls all appear correctly
     * and the viewport is simply empty. That is a miserable thing to debug,
     * which is why the decoder is wired in unconditionally.
     *
     * The decoder itself lives in public/draco/ and is fetched lazily by
     * DRACOLoader, only if a model actually turns out to be compressed.
     */
    const draco = new DRACOLoader();
    // Path comes from Astro via a data attribute, so it respects the site's
    // base path (/bubblotics-website/) without any string surgery here.
    draco.setDecoderPath(root.dataset.draco!);
    draco.setDecoderConfig({ type: 'wasm' });

    const loader = new GLTFLoader();
    loader.setDRACOLoader(draco);

    const gltf = await new Promise<any>((resolve, reject) => {
      loader.load(
        modelUrl,
        resolve,
        (evt) => {
          if (evt.total) {
            const pct = Math.round((evt.loaded / evt.total) * 100);
            say(root, `Loading model… ${pct}%`);
          }
        },
        () =>
          reject(
            new Error(
              `Could not fetch ${modelUrl}. Check the file exists in public/.`
            )
          )
      );
    });

    const model = gltf.scene as any;

    // Swap every material for the hologram one, and collect the meshes so
    // they can be listed and isolated.
    const meshes: any[] = [];
    model.traverse((child: any) => {
      if (!child.isMesh) return;
      child.material = holoMaterial;
      child.renderOrder = 1;
      meshes.push(child);
    });

    /*
     * Naming the subsystem buttons.
     *
     * Ideally parts are named "Intake-Roller", "Drivetrain-Wheel" and so on,
     * in which case grouping by the leading token gives a handful of tidy
     * subsystem buttons instead of fifty individual chips.
     *
     * But Onshape's defaults are "Part 1", "Part 2", "Part 3". Grouping those
     * by leading token yields a single button labelled "Part", which is
     * worse than useless. So: try the token grouping, and only keep it if it
     * actually distinguishes anything. Otherwise fall back to full names, and
     * if even those do not separate the model, hide the list entirely rather
     * than show one button that does nothing.
     */
    const clean = (s: string) => {
      let n = (s || 'Part')
        .replace(/^occurrence of\s+/i, '')
        .replace(/_mesh$/, '')
        .trim();

      /*
       * Three.js sanitises glTF names (spaces become underscores) and then
       * appends _1, _2, _3 to every repeat so each object is uniquely named.
       * An assembly with eight copies of "Part 3" arrives as Part_3,
       * Part_3_1 ... Part_3_7, which would list the same component eight
       * times and produce eight callouts pointing at eight identical
       * brackets.
       *
       * A name ending in TWO underscore-number groups is base plus dedupe
       * index, so drop the last one. A single group is part of the real name
       * ("Part 3") and is kept.
       */
      n = n.replace(/^(.+_\d+)_\d+$/, '$1');
      return n.replace(/_/g, ' ').trim();
    };

    const groupBy = (fn: (name: string) => string) => {
      const map = new Map<string, any[]>();
      for (const mesh of meshes) {
        const key = fn(clean(mesh.name)) || 'Part';
        if (!map.has(key)) map.set(key, []);
        map.get(key)!.push(mesh);
      }
      return map;
    };

    const byToken = groupBy((n) => n.split(/[-_.\s]/)[0]);
    const byFull = groupBy((n) => n);

    // Prefer the tidier token grouping, but only when it separates the model
    // into at least two meaningful pieces.
    const chosen = byToken.size >= 2 ? byToken : byFull;

    const parts: { name: string; objects: any[] }[] = [];
    for (const [name, objects] of chosen) parts.push({ name, objects });

    /* ── Frame it ──────────────────────────────────────────────────────
       Models arrive at wildly different scales and origins depending on how
       they were exported. Rather than trust that, measure the bounding box,
       recentre on the origin, and pull the camera back to fit. */
    const box = new THREE.Box3().setFromObject(model);
    const size = box.getSize(new THREE.Vector3());
    const centre = box.getCenter(new THREE.Vector3());
    model.position.sub(centre);

    const radius = Math.max(size.x, size.y, size.z) * 0.5 || 1;
    const dist = radius / Math.tan((camera.fov * Math.PI) / 360);
    camera.position.set(dist * 0.9, dist * 0.55, dist * 1.15);
    camera.near = radius / 100;
    camera.far = radius * 100;
    camera.updateProjectionMatrix();
    controls.target.set(0, 0, 0);
    controls.minDistance = radius * 0.8;
    controls.maxDistance = radius * 6;
    controls.update();

    scene.add(model);

    // Remember each part's home position and the direction it should fly
    // when exploded: outward from the model's centre.
    const homes = new Map<any, { pos: any; dir: any }>();
    model.traverse((child: any) => {
      if (!child.isMesh) return;
      const c = new THREE.Box3()
        .setFromObject(child)
        .getCenter(new THREE.Vector3());
      const dir = c.clone().normalize();
      if (dir.lengthSq() === 0) dir.set(0, 1, 0); // part sitting dead centre
      homes.set(child, { pos: child.position.clone(), dir });
    });

    /* ── Ready ─────────────────────────────────────────────────────── */
    statusEls(root).status!.hidden = true;

    const controlsEl = root.querySelector<HTMLElement>('[data-holo-controls]')!;
    const partsEl = root.querySelector<HTMLElement>('[data-holo-parts]')!;
    controlsEl.hidden = false;

    // ── Exploded view
    const explodeInput = root.querySelector<HTMLInputElement>('[data-holo-explode]')!;
    explodeInput.addEventListener('input', () => {
      const amount = Number(explodeInput.value) / 100;
      homes.forEach(({ pos, dir }, mesh) => {
        mesh.position.copy(pos).addScaledVector(dir, amount * radius * 1.1);
      });
    });

    // ── Reset
    root.querySelector('[data-holo-reset]')!.addEventListener('click', () => {
      explodeInput.value = '0';
      explodeInput.dispatchEvent(new Event('input'));
      camera.position.set(dist * 0.9, dist * 0.55, dist * 1.15);
      controls.target.set(0, 0, 0);
      controls.update();
      // Un-isolate everything.
      partsEl
        .querySelectorAll<HTMLButtonElement>('button[aria-pressed="true"]')
        .forEach((b) => b.setAttribute('aria-pressed', 'false'));
      model.traverse((c: any) => {
        if (c.isMesh) c.visible = true;
      });
    });

    // ── Spin toggle
    const spinBtn = root.querySelector<HTMLButtonElement>('[data-holo-spin]')!;
    if (reduced) {
      spinBtn.setAttribute('aria-pressed', 'false');
      spinBtn.textContent = 'Start spin';
    }
    spinBtn.addEventListener('click', () => {
      controls.autoRotate = !controls.autoRotate;
      spinBtn.setAttribute('aria-pressed', String(controls.autoRotate));
      spinBtn.textContent = controls.autoRotate ? 'Pause spin' : 'Start spin';
    });

    // Stop auto-rotating the moment someone takes hold of it. Fighting a
    // user's drag is the fastest way to make a viewer feel broken.
    controls.addEventListener('start', () => {
      if (controls.autoRotate) {
        controls.autoRotate = false;
        spinBtn.setAttribute('aria-pressed', 'false');
        spinBtn.textContent = 'Start spin';
      }
    });

    /* ── Callouts ──────────────────────────────────────────────────────
     * A label in the margin, a leader line, and a dot on the part, like an
     * annotated assembly drawing. The anchor is each subsystem's world-space
     * centre, projected to screen coordinates every frame so the lines keep
     * pointing at the right place as the model turns.
     *
     * Labels sit in two fixed columns rather than floating next to their
     * anchors. Floating labels overlap constantly on a rotating model, and
     * an overlapping label is worse than a longer leader line. This is also
     * how real drawings do it.
     */
    const leadersSvg = root.querySelector<SVGSVGElement>('[data-holo-leaders]')!;
    const calloutLayer = root.querySelector<HTMLElement>('[data-holo-callouts]')!;
    const SVG_NS = 'http://www.w3.org/2000/svg';

    // Cap the number shown. Past about eight the drawing turns into a mess of
    // crossing lines, and the numbered index below lists everything anyway.
    const callouts = parts.slice(0, 8).map((part, i) => {
      const group = document.createElementNS(SVG_NS, 'g');
      const line = document.createElementNS(SVG_NS, 'polyline');
      line.setAttribute('class', 'leader');
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('class', 'leader-dot');
      dot.setAttribute('r', '3');
      group.append(line, dot);
      leadersSvg.appendChild(group);

      const label = document.createElement('div');
      label.className = 'holo-callout';
      label.innerHTML =
        `<span class="holo-callout-num">${String(i + 1).padStart(2, '0')}</span>` +
        `<span class="holo-callout-name"></span>`;
      label.querySelector('.holo-callout-name')!.textContent = part.name;
      calloutLayer.appendChild(label);

      // The centre of this subsystem, in the model's own coordinates.
      const box = new THREE.Box3();
      part.objects.forEach((o: any) => box.expandByObject(o));
      const anchor = box.getCenter(new THREE.Vector3());

      return { part, group, line, dot, label, anchor, index: i };
    });

    const projected = new THREE.Vector3();

    function layoutCallouts() {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      leadersSvg.setAttribute('viewBox', `0 0 ${w} ${h}`);

      // Project every anchor first, so sides and vertical order can be
      // decided from the actual on-screen positions.
      const points = callouts.map((c) => {
        /*
         * Recomputed from the live world bounding box rather than the anchor
         * captured at load, so the leader follows a part as the exploded-view
         * slider pushes it outward.
         */
        const box = new THREE.Box3();
        c.part.objects.forEach((o: any) => box.expandByObject(o));
        box.getCenter(projected);
        const p = projected.project(camera);
        return {
          c,
          x: (p.x * 0.5 + 0.5) * w,
          y: (-p.y * 0.5 + 0.5) * h,
          behind: p.z > 1,
        };
      });

      /*
       * Split into two even columns by horizontal order rather than by which
       * half of the canvas each anchor happens to fall in. A robot sitting
       * slightly off-centre puts nearly every anchor on one side, and all the
       * labels then stack into one overlapping column while the other margin
       * sits empty.
       */
      const byX = [...points].sort((a, b) => a.x - b.x);
      const half = Math.ceil(byX.length / 2);
      const left = byX.slice(0, half).sort((a, b) => a.y - b.y);
      const right = byX.slice(half).sort((a, b) => a.y - b.y);

      const MARGIN = 14;
      const SLOT = 46;

      const place = (list: typeof points, side: 'left' | 'right') => {
        // Spread the labels down the column so they never overlap, then
        // centre the stack vertically.
        const total = list.length * SLOT;
        let top = Math.max(MARGIN, (h - total) / 2);

        list.forEach((p) => {
          const labelW = 170;
          const x = side === 'left' ? MARGIN : w - MARGIN - labelW;
          const y = top;
          top += SLOT;

          p.c.label.style.transform = `translate(${x}px, ${y}px)`;
          p.c.label.style.width = `${labelW}px`;
          p.c.label.style.textAlign = side === 'left' ? 'left' : 'right';
          p.c.label.style.alignItems = side === 'left' ? 'flex-start' : 'flex-end';
          // Anything facing away from the camera is faded rather than hidden,
          // so labels do not pop in and out while the model spins.
          p.c.label.style.opacity = p.behind ? '0.25' : '1';
          p.c.group.style.opacity = p.behind ? '0.25' : '1';

          // Leader: out from the label, a short horizontal run, then a
          // straight shot to the part. Three points, like a drawing.
          const startX = side === 'left' ? x + labelW * 0.02 : x + labelW;
          const startY = y + 22;
          const elbowX = side === 'left' ? startX + 28 : startX - 28;

          p.c.line.setAttribute(
            'points',
            `${startX},${startY} ${elbowX},${startY} ${p.x},${p.y}`
          );
          p.c.dot.setAttribute('cx', String(p.x));
          p.c.dot.setAttribute('cy', String(p.y));
        });
      };

      place(left, 'left');
      place(right, 'right');
    }

    const setCalloutActive = (index: number, on: boolean) => {
      const c = callouts[index];
      if (!c) return;
      c.label.classList.toggle('is-active', on);
      c.group.classList.toggle('is-active', on);
    };

    root.querySelector<HTMLElement>('[data-holo-hint]')!.hidden = false;

    // ── Subsystem isolation
    if (parts.length > 1) {
      const list = root.querySelector<HTMLElement>('[data-holo-parts-list]')!;
      partsEl.hidden = false;

      parts.forEach((part, partIndex) => {
        const li = document.createElement('li');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.innerHTML = `<span class="holo-num">${String(partIndex + 1).padStart(2, '0')}</span><span></span>`;
        btn.lastElementChild!.textContent = part.name;
        btn.setAttribute('aria-pressed', 'false');

        // Hovering or focusing a row lights up its callout on the drawing.
        // Focus as well as hover, so this works from the keyboard too.
        const hi = (on: boolean) => setCalloutActive(partIndex, on);
        btn.addEventListener('pointerenter', () => hi(true));
        btn.addEventListener('pointerleave', () => hi(false));
        btn.addEventListener('focus', () => hi(true));
        btn.addEventListener('blur', () => hi(false));

        btn.addEventListener('click', () => {
          const on = btn.getAttribute('aria-pressed') === 'true';

          // Clear any other isolation first, so the buttons behave like
          // radio buttons rather than accumulating.
          list
            .querySelectorAll<HTMLButtonElement>('button')
            .forEach((b) => b.setAttribute('aria-pressed', 'false'));

          if (on) {
            model.traverse((c: any) => {
              if (c.isMesh) c.visible = true;
            });
          } else {
            btn.setAttribute('aria-pressed', 'true');
            model.traverse((c: any) => {
              if (c.isMesh) c.visible = part.objects.includes(c);
            });
          }
        });

        li.appendChild(btn);
        list.appendChild(li);
      });
    }

    /* ── Render loop ───────────────────────────────────────────────── */
    const clock = new THREE.Clock();
    let running = true;

    function frame() {
      if (!running) return;
      holoMaterial.uniforms.uTime.value = clock.getElapsedTime();
      controls.update();
      renderer.render(scene, camera);
      // After render, so the callouts use the camera position that was just
      // drawn. Doing it before leaves the labels one frame behind the model,
      // which is visible as the leaders lagging during a drag.
      layoutCallouts();
      requestAnimationFrame(frame);
    }
    frame();

    // Only render while on screen. A WebGL loop left running in a scrolled
    // past section is one of the easiest ways to flatten a laptop battery.
    const visIO = new IntersectionObserver(
      (entries) => {
        const wasRunning = running;
        running = entries[0].isIntersecting && !document.hidden;
        if (running && !wasRunning) frame();
      },
      { threshold: 0 }
    );
    visIO.observe(root);

    document.addEventListener('visibilitychange', () => {
      const wasRunning = running;
      running = !document.hidden;
      if (running && !wasRunning) frame();
    });

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        camera.aspect = stage.clientWidth / stage.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(stage.clientWidth, stage.clientHeight);
      }, 150);
    });
  }
</script>
