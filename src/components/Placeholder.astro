---
/*
 * A frame where a real photo will go.
 *
 * ── Two audiences, two looks ────────────────────────────────────────────
 * Publicly (the deployed site) this is a quiet branded panel: a soft navy
 * gradient with the team mark faintly in the middle. It reads as a design
 * element, not as something broken, and it claims nothing. There is no
 * stock photo pretending to be the team and no "coming soon" sign.
 *
 * Locally (`npm run dev`) the same panel is labelled, and a caption under
 * it says exactly what the photo should show and which file to save it as.
 * That is the brief for whoever takes the picture, and it never ships.
 *
 * An earlier version showed the labels and file paths to everyone, behind a
 * dashed border. It did its job for the team and made the public site look
 * unfinished. See src/lib/publish.ts for the rule this follows.
 *
 * Usage:
 *   <Placeholder path="src/assets/team/team-photo.jpg" ratio="16 / 9">
 *     A wide shot of the whole team.
 *   </Placeholder>
 *
 * `compact` fills its parent instead of setting its own shape, for use
 * inside a card's media area that already has an aspect ratio. It shows no
 * caption, only the path, even locally.
 */

import Logo from './Logo.astro';
import { SHOW_UNFINISHED } from '../lib/publish';

interface Props {
  /** Exact path the asset should be saved to. Shown locally only. */
  path: string;
  /** CSS aspect-ratio for the frame, e.g. "16 / 9" or "1 / 1". */
  ratio?: string;
  /** Short label shown locally, e.g. "Photo", "Robot". */
  kind?: string;
  /** Fill the parent instead of setting a shape. */
  compact?: boolean;
  class?: string;
}

const {
  path,
  ratio = '16 / 9',
  kind = 'Photo',
  compact = false,
  class: className = '',
} = Astro.props;

const dev = SHOW_UNFINISHED;
---

<figure
  class:list={['ph', { 'ph-compact': compact }, className]}
  style={compact ? undefined : `--ph-ratio: ${ratio};`}
  aria-hidden={dev ? undefined : 'true'}
>
  <div class="ph-box">
    <span class="ph-mark">
      <Logo variant="mark" size={compact ? 44 : 64} />
    </span>

    {
      dev && (
        <span class="ph-label">
          {kind} placeholder
        </span>
      )
    }
  </div>

  {
    dev && !compact && (
      <figcaption class="ph-caption">
        <span class="ph-brief">
          <slot />
        </span>
        <code class="ph-path">{path}</code>
      </figcaption>
    )
  }

  {dev && compact && <code class="ph-path ph-path-overlay">{path}</code>}
</figure>

<style>
  .ph {
    position: relative;
    margin: 0;
  }

  .ph-box {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: var(--ph-ratio);
    overflow: hidden;
    border-radius: var(--radius-lg);

    /*
     * A light source at the top right fading into deep navy. Close enough
     * to how a lit photo reads that the frame sits comfortably among real
     * images once some arrive.
     */
    background:
      radial-gradient(
        70% 90% at 85% 10%,
        rgba(89, 149, 237, 0.3),
        transparent 60%
      ),
      linear-gradient(160deg, #13294a 0%, #0c1b31 55%, #09152a 100%);
  }

  /* Fills the card's media area; the card already clips the corners. */
  .ph-compact,
  .ph-compact .ph-box {
    height: 100%;
  }

  .ph-compact .ph-box {
    aspect-ratio: auto;
    border-radius: 0;
  }

  /* The team mark, faint. Present enough to say whose frame this is,
     quiet enough that it never competes with the page. */
  .ph-mark {
    display: block;
    opacity: 0.16;
    filter: grayscale(1) brightness(1.6);
  }

  .ph-label {
    position: absolute;
    top: var(--sp-4);
    left: var(--sp-4);
    padding: 4px var(--sp-3);
    border-radius: var(--radius-pill);
    background: rgba(252, 250, 249, 0.07);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--highlight);
  }

  /* Captions are Source Sans 3 Italic, per the branding guide. */
  .ph-caption {
    margin-top: var(--sp-3);
    font-style: italic;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .ph-brief {
    display: block;
  }

  .ph-path {
    display: block;
    margin-top: var(--sp-2);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-style: normal;
    font-size: var(--text-meta);
    /* Long paths must not force the page to scroll sideways on a phone. */
    overflow-wrap: anywhere;
    color: var(--accent-soft);
  }

  .ph-path-overlay {
    position: absolute;
    left: var(--sp-3);
    right: var(--sp-3);
    bottom: var(--sp-3);
    margin: 0;
    padding: 4px var(--sp-3);
    border-radius: var(--radius-sm);
    background: rgba(7, 15, 28, 0.78);
  }
</style>
