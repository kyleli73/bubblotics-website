---
/*
 * Site header.
 *
 * Sticky, translucent, and it changes state on scroll: transparent over the
 * hero so the bubbles show through, then it condenses into a solid glass bar
 * once you move down the page. That transition is handled in the header's
 * own script at the bottom of this file.
 *
 * The ten pages are grouped under four headings (Team, Build, Season,
 * Sponsors), each opening a dropdown. Grouping is what got the bar back
 * under 940px: four words and a button fit on a small laptop, ten did not.
 *
 * Below 940px the whole thing collapses into a full-screen numbered panel.
 */

import { nav, navGroups } from '../data/site';
import { url, isActive } from '../lib/paths';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="shell header-inner">
    <a href={url('/')} class="brand" aria-label="Bubblotics, Team 35858, home">
      <Logo variant="full" size={42} />
    </a>

    <!--
      Each group is a <li> holding a button and a panel. The button carries
      aria-expanded and aria-controls so the state is announced, and the
      panel is hidden with the `hidden` attribute rather than only with CSS,
      which keeps its links out of the tab order while closed.

      Opening is handled by CSS on :hover and :focus-within for pointer and
      keyboard users, and by the script below for a click or a tap. Hover
      alone would strand anyone on a touchscreen, since there is no hover to
      have; click alone would feel sticky with a mouse.
    -->
    <nav class="desktop-nav" aria-label="Main">
      <ul class="nav-groups">
        {
          navGroups.map((group) => {
            const groupId = `nav-group-${group.label.toLowerCase()}`;
            // A group counts as current if any page inside it is the page
            // you are on, so "Build" stays lit while you read /robots/.
            const active = group.items.some((item) =>
              isActive(url(item.href), currentPath)
            );

            return (
              <li class="nav-group" data-nav-group>
                <button
                  type="button"
                  class:list={['nav-trigger', { active }]}
                  aria-expanded="false"
                  aria-controls={groupId}
                  data-nav-trigger
                >
                  <span class="nav-trigger-label">{group.label}</span>
                  <svg
                    class="nav-chevron"
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 9l6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="square"
                    />
                  </svg>
                </button>

                <div class="nav-panel" id={groupId} data-nav-panel hidden>
                  <ul>
                    {group.items.map((item) => {
                      const itemActive = isActive(url(item.href), currentPath);
                      return (
                        <li>
                          <a
                            href={url(item.href)}
                            class:list={['nav-item', { active: itemActive }]}
                            aria-current={itemActive ? 'page' : undefined}
                          >
                            <span class="nav-item-label">{item.label}</span>
                            <span class="nav-item-blurb">{item.blurb}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a href={url('/sponsors/')} class="btn btn-primary btn-sm header-cta">
      Sponsor Us
    </a>

    <button
      class="menu-toggle"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="sr-only">Open menu</span>
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </div>
</header>

<!--
  The mobile panel is a sibling of the header rather than a child, so it can
  cover the full viewport without fighting the header's backdrop-filter.
  `inert` is the important bit: while the panel is closed, it removes every
  link inside from the tab order and from screen readers. Without it, a
  keyboard user tabs into an invisible menu and gets stranded.
-->
<div class="mobile-nav" id="mobile-nav" inert>
  <nav class="shell" aria-label="Mobile">
    <ul>
      {
        nav.map((item, i) => {
          const active = isActive(url(item.href), currentPath);
          return (
            <li style={`--i: ${i}`}>
              <a
                href={url(item.href)}
                class:list={['mobile-link', { active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span class="mobile-link-num">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <a href={url('/sponsors/')} class="btn btn-primary mobile-cta">
      Sponsor Us
    </a>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    transition:
      background var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      backdrop-filter var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  /* Added by the script once the page scrolls past the hero. */
  .site-header.scrolled {
    background: rgba(7, 15, 28, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.7);
  }

  /* Slides out of the way when you scroll down, comes back the moment you
     scroll up. Gives the content the full screen without ever making
     someone scroll to the top to reach the nav. */
  .site-header.hidden {
    transform: translateY(-105%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: var(--header-h);
  }

  .brand {
    text-decoration: none;
    flex-shrink: 0;
  }

  .desktop-nav {
    display: none;
  }

  .nav-groups {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-group {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-3);
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    cursor: pointer;

    font-family: var(--font-display);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease);
  }

  .nav-trigger:hover,
  .nav-group:focus-within .nav-trigger,
  .nav-trigger[aria-expanded='true'] {
    color: var(--ink);
  }

  .nav-trigger.active {
    color: var(--ink);
  }

  /*
   * ── The bar ────────────────────────────────────────────────────────────
   * A short yellow line centred under the word. It hangs off the label, not
   * the button: the button also holds the chevron, so a mark centred on the
   * button sat right of the word's centre.
   *
   * Every item has one, collapsed to nothing. It grows out from the centre
   * when you point at the item, reach it from the keyboard, or open its
   * menu, and it stays while you move down into that menu (it follows the
   * whole group, not just the button). It also rests under the group that
   * holds the page you are on.
   *
   * There is only ever one. Point at another item and the resting bar
   * shrinks away as the new one grows, then returns when you leave. That
   * hand-off is what the :has() rule at the end does. It replaced a faint
   * pill that appeared behind a hovered item; with the bar doing that job,
   * the pill was a second indicator saying the same thing.
   */
  .nav-trigger-label {
    position: relative;
  }

  .nav-trigger-label::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 16px;
    height: 3px;
    margin-left: -8px;
    border-radius: var(--radius-pill);
    background: var(--highlight);
    transform: scaleX(0);
    opacity: 0;
    transition:
      transform 320ms var(--ease-smooth),
      opacity 200ms var(--ease);
  }

  .nav-trigger.active .nav-trigger-label::after,
  .nav-group:hover .nav-trigger-label::after,
  .nav-group:focus-within .nav-trigger-label::after,
  .nav-trigger[aria-expanded='true'] .nav-trigger-label::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .nav-groups:has(.nav-group:hover)
    .nav-group:not(:hover)
    .nav-trigger.active
    .nav-trigger-label::after,
  .nav-groups:has(.nav-group:focus-within)
    .nav-group:not(:focus-within)
    .nav-trigger.active
    .nav-trigger-label::after {
    transform: scaleX(0);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-trigger-label::after {
      transition: none;
    }
  }

  .nav-chevron {
    transition: transform var(--dur-fast) var(--ease);
    color: var(--ink-faint);
  }

  .nav-group:hover .nav-chevron,
  .nav-group:focus-within .nav-chevron,
  .nav-trigger[aria-expanded='true'] .nav-chevron {
    transform: rotate(180deg);
    color: var(--highlight);
  }

  /* ── The dropdown ─────────────────────────────────────────────────── */

  .nav-panel {
    position: absolute;
    top: calc(100% - 4px);
    left: 0;
    min-width: 264px;
    padding: var(--sp-2);
    z-index: 10;

    /* A rounded floating panel, opaque enough to read over the hero
       bubbles, lifted off the page by shadow rather than outlined. */
    border-radius: var(--radius-lg);
    background: var(--surface-menu);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: var(--shadow-2);

    /*
     * `hidden` is on the element in the markup, so the panel is genuinely
     * out of the tab order when closed. This rule un-hides it for hover and
     * keyboard focus without JavaScript having to run at all: display is
     * forced back on, overriding [hidden]'s display:none.
     */
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .nav-group:hover .nav-panel,
  .nav-group:focus-within .nav-panel,
  .nav-panel[data-open] {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * A hover bridge. Without it the 4px gap between the trigger and the
   * panel counts as "not hovering either", so the panel closes while the
   * pointer is still travelling toward it. This pads the gap invisibly.
   */
  .nav-panel::before {
    content: '';
    position: absolute;
    top: -10px;
    left: 0;
    right: 0;
    height: 10px;
  }

  .nav-panel ul {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: block;
    padding: var(--sp-3);
    border-radius: var(--radius);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
  }

  .nav-item:hover,
  .nav-item:focus-visible {
    background: var(--surface-2);
  }

  /* The page you are on: its label turns yellow. */
  .nav-item.active .nav-item-label {
    color: var(--highlight);
  }

  .nav-item-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }

  .nav-item-blurb {
    display: block;
    margin-top: 2px;
    font-size: var(--text-meta);
    line-height: 1.4;
    color: var(--ink-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-panel,
    .nav-chevron {
      transition: none;
    }
  }

  .header-cta {
    display: none;
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-pill);
    border: 0;
    background: var(--surface-2);
    color: var(--ink);
    background: rgba(89, 149, 237, 0.08);
    backdrop-filter: blur(8px);
    transition: background var(--dur-fast) var(--ease);
  }

  .menu-toggle:hover {
    background: rgba(89, 149, 237, 0.2);
  }

  /* Both icons are stacked in the same grid cell; only one is shown. */
  .menu-toggle :global(svg) {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur) var(--ease);
  }

  .menu-toggle :global(.icon-close) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.7);
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    opacity: 0;
    transform: rotate(90deg) scale(0.7);
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    opacity: 1;
    transform: none;
  }

  /*
   * 940px. Four group headings plus the Sponsor Us button fit comfortably
   * here; the flat ten-item version this replaced needed 1180px.
   *
   * If you add a fifth group, re-measure. The failure is silent: the
   * button does not wrap, it just gets pushed out of the header.
   */
  @media (min-width: 940px) {
    .desktop-nav {
      display: block;
    }
    .header-cta {
      display: inline-flex;
    }
    .menu-toggle {
      display: none;
    }
  }

  /* ── Mobile panel ─────────────────────────────────────────────────── */

  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    align-items: center;
    background: rgba(7, 15, 28, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease);
    overflow-y: auto;
    padding-block: calc(var(--header-h) + var(--sp-5)) var(--sp-6);
  }

  .mobile-nav.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-link {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-3) 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--track-snug);
    color: var(--ink);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease),
      transform var(--dur) var(--ease);

    /* Each item slides up slightly later than the one above it, so the
       menu unfolds instead of appearing all at once. */
    opacity: 0;
    transform: translateY(18px);
  }

  .mobile-nav.open .mobile-link {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--dur) var(--ease) calc(var(--i) * 38ms + 90ms),
      transform var(--dur) var(--ease) calc(var(--i) * 38ms + 90ms),
      color var(--dur-fast) var(--ease);
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--highlight);
  }

  .mobile-link-num {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    color: var(--accent);
    min-width: 2ch;
  }

  .mobile-cta {
    margin-top: var(--sp-6);
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-link {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  /*
   * Header behaviour. Three jobs:
   *   1. Publish the real header height as a CSS variable.
   *   2. Condense and auto-hide the bar as the page scrolls.
   *   3. Open and close the mobile panel, accessibly.
   */

  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');

  if (header) {
    /* ── 1. Header height ────────────────────────────────────────────
       Anchor links and sticky offsets need to know how tall the bar is.
       Measuring it beats hard-coding a number that drifts out of date
       the first time someone changes the logo size. */
    const publishHeight = () => {
      document.documentElement.style.setProperty(
        '--header-h',
        `${header.offsetHeight}px`
      );
    };
    publishHeight();
    window.addEventListener('resize', publishHeight);

    /* ── 2. Scroll state ─────────────────────────────────────────────
       Scroll events fire far more often than the screen refreshes.
       requestAnimationFrame collapses a burst of them into one update
       per frame, which is the difference between smooth and janky on a
       mid-range phone. */
    let lastY = window.scrollY;
    let ticking = false;

    const onScroll = () => {
      const y = window.scrollY;

      header.classList.toggle('scrolled', y > 24);

      // Only hide once well past the hero, and never while the mobile
      // menu is open (the bar holds the close button).
      const menuOpen = panel?.classList.contains('open');
      const goingDown = y > lastY;
      header.classList.toggle('hidden', goingDown && y > 400 && !menuOpen);

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true } // tells the browser we won't block the scroll
    );
  }

  /* ── 3. Mobile menu ───────────────────────────────────────────────── */
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);

      // `inert` keeps closed links out of the tab order and out of the
      // accessibility tree. Removing it is what makes the panel usable.
      if (open) {
        panel.removeAttribute('inert');
      } else {
        panel.setAttribute('inert', '');
      }

      // Stop the page behind the overlay from scrolling.
      document.body.style.overflow = open ? 'hidden' : '';

      const label = toggle.querySelector('.sr-only');
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';

      // Move focus into the panel so a keyboard user lands somewhere
      // useful, and hand it back to the button on close.
      if (open) {
        panel.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        (toggle as HTMLButtonElement).focus();
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes it, which is what everyone expects from an overlay.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        setOpen(false);
      }
    });

    // Tapping a link navigates; close first so the panel isn't still up
    // if the browser restores this page from its back-forward cache.
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Crossing into desktop layout with the panel open would leave the
    // body unscrollable and no visible way to close it.
    const desktop = window.matchMedia('(min-width: 940px)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && panel.classList.contains('open')) setOpen(false);
    });
  }

  /* ─────────────────────────────────────────────────────────────────────
     Desktop dropdowns: click and touch
     ─────────────────────────────────────────────────────────────────────
     Hover and keyboard focus are handled entirely in CSS above. This adds
     the two cases CSS cannot: a click (which should latch the panel open
     rather than closing it the moment the pointer leaves) and a tap on a
     touchscreen, where there is no hover at all.

     A touch device fires a synthetic hover on tap, so without this a first
     tap would open the panel and immediately follow the link behind it.
     The trigger is a <button>, not a link, precisely so that tap has
     somewhere harmless to land.
  */
  const groups = document.querySelectorAll<HTMLElement>('[data-nav-group]');

  const closeAllGroups = () => {
    groups.forEach((g) => {
      g.querySelector('[data-nav-trigger]')?.setAttribute(
        'aria-expanded',
        'false'
      );
      g.querySelector('[data-nav-panel]')?.removeAttribute('data-open');
    });
  };

  groups.forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>('[data-nav-trigger]');
    const panel = group.querySelector<HTMLElement>('[data-nav-panel]');
    if (!trigger || !panel) return;

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = panel.hasAttribute('data-open');
      closeAllGroups();
      if (!isOpen) {
        panel.setAttribute('data-open', '');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  if (groups.length > 0) {
    // Clicking anywhere else, or pressing Escape, dismisses an open panel.
    document.addEventListener('click', closeAllGroups);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = document.querySelector<HTMLElement>('[data-nav-panel][data-open]');
      if (!open) return;
      // Hand focus back to the trigger, or the key press strands the
      // keyboard user on an element that just disappeared.
      open.closest('[data-nav-group]')
        ?.querySelector<HTMLButtonElement>('[data-nav-trigger]')
        ?.focus();
      closeAllGroups();
    });
  }
</script>
