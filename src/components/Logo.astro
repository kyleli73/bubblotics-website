---
/*
 * Team mark.
 *
 * Renders the real logo from src/assets/brand/logo.png as soon as that file
 * exists. Until then it falls back to a placeholder, so the site never shows
 * a broken image. See src/lib/brand.ts for the one-step instructions.
 *
 * The branding guide lists three approved variants. `variant` maps onto them:
 *   'mark'   symbol only
 *   'full'   symbol plus the name and number
 */

import { Image } from 'astro:assets';
import { logo, logoIsVector } from '../lib/brand';

interface Props {
  variant?: 'mark' | 'full';
  size?: number;
  class?: string;
}

const { variant = 'full', size = 46, class: className = '' } = Astro.props;

const alt = 'Bubblotics, Team 35858';

/*
 * `size` means HEIGHT, not width.
 *
 * The mark is landscape (two bubbles side by side, roughly 1.32:1), not
 * square. Asking for a square box would letterbox it: the image would be
 * scaled down until its width fitted, leaving it visually much smaller than
 * the space it occupies and with dead air above and below.
 *
 * So height is fixed and width follows the artwork's real proportions. Both
 * are still written into the HTML, which is what lets the browser reserve
 * the right space before the image loads and stops the header jumping.
 */
const aspect = logo ? logo.width / logo.height : 1;
const markHeight = size;
const markWidth = Math.round(size * aspect);
---

<span class={`logo ${className}`} data-variant={variant}>
  {
    logo ? (
      logoIsVector ? (
        /*
         * SVG is already resolution independent, so it is served as-is.
         * Running it through the image pipeline would only rasterise it.
         */
        <img
          class="logo-mark"
          src={logo.src}
          alt={alt}
          width={markWidth}
          height={markHeight}
          loading="eager"
        />
      ) : (
        /*
         * A raster logo is resized at build time. `densities` emits a 2x
         * copy as well, so the mark stays crisp on a phone or a Retina
         * display without shipping the full-size original to everyone.
         */
        <Image
          class="logo-mark"
          src={logo}
          alt={alt}
          width={markWidth}
          height={markHeight}
          densities={[1, 2]}
          loading="eager"
        />
      )
    ) : (
      /*
       * ── PLACEHOLDER ──────────────────────────────────────────────────
       * Only renders while src/assets/brand/logo.png is missing. Add that
       * file and this disappears on its own.
       */
      <svg
        class="logo-mark logo-placeholder"
        width={size}
        height={size}
        viewBox="0 0 48 48"
        role="img"
        aria-label={alt}
      >
        <defs>
          <linearGradient id="bl-g1" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#8AB6F4" />
            <stop offset="100%" stop-color="#5995ED" />
          </linearGradient>
          <radialGradient id="bl-shine" cx="32%" cy="28%" r="60%">
            <stop offset="0%" stop-color="#FCFAF9" stop-opacity="0.85" />
            <stop offset="60%" stop-color="#FCFAF9" stop-opacity="0" />
          </radialGradient>
        </defs>

        <circle cx="38.5" cy="11.5" r="7" fill="#FEC601" opacity="0.9" />
        <circle cx="10" cy="12.5" r="4.5" fill="#5995ED" opacity="0.55" />
        <circle cx="21" cy="28" r="18" fill="url(#bl-g1)" />
        <circle cx="21" cy="28" r="18" fill="url(#bl-shine)" />
        <text
          x="21"
          y="28"
          text-anchor="middle"
          dominant-baseline="central"
          fill="#102542"
          font-family="Helvetica Neue, Helvetica, Arial, sans-serif"
          font-size="11.5"
          font-weight="700"
          letter-spacing="-0.4"
        >
          35858
        </text>
      </svg>
    )
  }

  {
    variant === 'full' && (
      <span class="logo-word">
        <span class="logo-name">Bubblotics</span>
        <span class="logo-num">Team 35858</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: inherit;
  }

  .logo-mark {
    flex-shrink: 0;
    /* The artwork is square with the two bubbles filling most of the frame.
       `contain` keeps it from being cropped at any size it is asked for. */
    object-fit: contain;
    transition: transform var(--dur) var(--ease);
  }

  /* The mark tips and lifts when you hover the header link, like a bubble
     catching a draft. */
  :global(a:hover) > .logo .logo-mark {
    transform: translateY(-2px) rotate(-4deg);
  }

  .logo-word {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .logo-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .logo-num {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* Below 380px the wordmark is dropped so the header never wraps. */
  @media (max-width: 380px) {
    .logo-word {
      display: none;
    }
  }
</style>
