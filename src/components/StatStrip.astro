---
/*
 * The animated numbers strip.
 *
 * Each figure counts up from zero when it scrolls into view. The counting is
 * driven entirely by the data-count attributes below; see src/scripts/motion.ts.
 *
 * Note the fallback text inside each <span>: it is the finished number, so a
 * visitor with JavaScript off sees "12", not an empty box.
 */

import { stats } from '../data/site';
---

<section class="stats-band" aria-label="Team statistics">
  <div class="shell">
    <ul class="stats-grid" data-reveal data-stagger>
      {
        stats.map((stat) => (
          <li class="stat">
            <span
              class="stat-value"
              data-count={stat.count === false ? undefined : stat.value}
              data-count-suffix={stat.count === false ? undefined : stat.suffix}
            >
              {/*
                A year is written plainly. toLocaleString() would render
                2026 as "2,026", which is the correct formatting for a
                quantity and wrong for a date.
              */}
              {stat.count === false
                ? String(stat.value)
                : stat.value.toLocaleString()}
              {stat.suffix}
            </span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats-band {
    position: relative;
    padding-block: var(--sp-6) var(--sp-4);
  }

  /*
   * Four tiles with space between them. These were cells in a ruled grid,
   * separated by 2px lines; as separate rounded surfaces each number reads
   * as its own fact, and there is no grid of lines to line up.
   */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-4);
    }
  }

  .stat {
    padding: var(--sp-6) var(--sp-5);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
  }

  .stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    /* Tabular figures stop the number jittering sideways as it counts. */
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    display: block;
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
