---
/*
 * The animated numbers strip.
 *
 * Each figure counts up from zero when it scrolls into view. The counting is
 * driven entirely by the data-count attributes below; see src/scripts/motion.ts.
 *
 * Note the fallback text inside each <span>: it is the finished number, so a
 * visitor with JavaScript off sees "12", not an empty box.
 */

import { stats } from '../data/site';
---

<section class="stats-band" aria-label="Team statistics">
  <div class="shell">
    <ul class="stats-grid" data-reveal data-stagger>
      {
        stats.map((stat) => (
          <li class="stat">
            <span
              class="stat-value"
              data-count={stat.count === false ? undefined : stat.value}
              data-count-suffix={stat.count === false ? undefined : stat.suffix}
            >
              {/*
                A year is written plainly. toLocaleString() would render
                2026 as "2,026", which is the correct formatting for a
                quantity and wrong for a date.
              */}
              {stat.count === false
                ? String(stat.value)
                : stat.value.toLocaleString()}
              {stat.suffix}
            </span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats-band {
    position: relative;
    border-block: var(--edge);
    background: rgba(89, 149, 237, 0.04);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 760px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /*
   * Dividers drawn as borders on the cells rather than as a gap, so the
   * row reads as one ruled band. Every cell gets a right edge and the last
   * in each row has it removed, which is what keeps the outer edge clean
   * at both breakpoints.
   */
  .stat {
    padding: var(--sp-6) var(--sp-5);
    border-right: var(--edge);
    border-bottom: var(--edge);
  }

  .stat:nth-child(2n) {
    border-right: 0;
  }

  .stat:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  @media (min-width: 760px) {
    .stat {
      border-bottom: 0;
    }

    .stat:nth-child(2n) {
      border-right: var(--edge);
    }

    .stat:last-child {
      border-right: 0;
    }
  }

  .stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    /* Tabular figures stop the number jittering sideways as it counts. */
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    display: block;
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
