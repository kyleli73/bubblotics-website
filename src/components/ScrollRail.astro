---
/*
 * The numbered progress rail down the left edge.
 *
 * A floating column of section numbers that marks whichever section you are
 * currently inside. It answers two questions a long single-page site
 * otherwise leaves open: how far through am I, and how much is left.
 *
 * ── Decisions worth knowing ────────────────────────────────────────────
 *
 * Desktop only. On a phone it would eat a fifth of the screen width to say
 * something the scrollbar already says, so it only appears from 1380px, the
 * first width with a margin wide enough to hold it beside the content with
 * room to breathe.
 *
 * It is a real <nav> of real anchor links, not decoration. Clicking a number
 * jumps to that section, and the whole rail is reachable by keyboard. The
 * numerals are aria-hidden so a screen reader announces "Software" rather
 * than "zero three Software".
 *
 * IntersectionObserver decides which entry is active, not a scroll handler.
 * A scroll handler here would run on every one of the sixty frames a second
 * Lenis produces and recompute element positions each time; the observer is
 * told once and then only fires when something crosses the line.
 */

interface Props {
  /** In document order. `id` must match the section's id attribute. */
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="rail" aria-label="Page sections" data-rail>
  <div class="rail-panel" data-rail-panel style="--active: 0">
    <!--
      One highlight for the whole rail, sitting behind the active row. It
      glides to the new row when the section changes instead of the old row
      switching off and the new one switching on. It lives outside the <ol>
      because a list may only contain list items.
    -->
    <span class="rail-indicator" aria-hidden="true"></span>

    <ol>
      {
        sections.map((s, i) => (
          <li style={`--i: ${i}`}>
            <a href={`#${s.id}`} class="rail-link" data-rail-link={s.id}>
              <span class="rail-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="rail-label-clip">
                <span class="rail-label">{s.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  /*
   * ── How the rail moves ──────────────────────────────────────────────
   * At rest it is a slim capsule of numbers. On hover or keyboard focus it
   * widens into a near-opaque panel and the section names fade in beside
   * the numbers, one after another.
   *
   * Everything here is tuned for smoothness, which an earlier version
   * lacked, for three reasons worth remembering:
   *
   *   1. The width adapts to the labels on its own. Each row is a small
   *      grid: the number, then a label column that animates from 0fr to
   *      1fr. An fr column in a shrink-to-fit box grows to exactly its
   *      content's natural width, so the panel opens to precisely what the
   *      longest name needs, whatever the names are, with no measuring.
   *      The version before this measured the links in script, but that
   *      measurement left out their right padding and caught the labels
   *      mid-shift, so the panel opened 18px too narrow and "Software" ran
   *      into the edge. The one before that animated max-width to 14ch,
   *      far wider than any label, so it shot out and then stalled.
   *
   *   2. The corner radius never changes. It used to animate from 999px to
   *      24px, but a radius is capped at half the element's size, so the
   *      visible corners did nothing until the last tenth of the animation
   *      and then popped.
   *
   *   3. Only cheap properties move with the reveal. The labels are always
   *      laid out at full width and merely clipped by the panel, so they
   *      fade and slide (opacity and transform, which the browser does on
   *      the graphics card) instead of changing size.
   *
   * Opening is slower than closing. The labels leave first and quickly,
   * then the panel folds in behind them, so no text is ever wiped by the
   * closing edge.
   */
  .rail {
    display: none;

    --rail-pad: 6px;
    /* Rows breathe a little more on tall screens: 32px up to 36px. */
    --row-h: clamp(32px, 3.5vh, 36px);
    --row-gap: 2px;
    --num-w: 16px;
    --link-pad: 12px;
    --label-gap: 10px;
  }

  /*
   * 1380px. The rail must fit in the margin beside the content at rest.
   * The content column is 1200px wide with 32px of padding; below this
   * width the capsule would crowd the start of every line of text. When
   * open it deliberately floats over the page, which the opaque panel
   * makes safe.
   */
  @media (min-width: 1380px) {
    .rail {
      display: block;
      position: fixed;
      left: var(--sp-5);
      top: 50%;
      transform: translateY(-50%);
      z-index: var(--z-rail);
    }
  }

  @media (min-width: 1500px) {
    .rail {
      left: var(--sp-6);
    }
  }

  .rail-panel {
    position: relative;
    padding: var(--rail-pad);
    overflow: hidden;
    border-radius: 26px;

    background: rgba(10, 21, 38, 0.55);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: var(--shadow-1);

    transition:
      background 380ms var(--ease-smooth) 70ms,
      box-shadow 380ms var(--ease-smooth) 70ms;
  }

  .rail:hover .rail-panel,
  .rail:focus-within .rail-panel {
    background: var(--surface-menu);
    box-shadow: var(--shadow-2);
    transition:
      background 480ms var(--ease-smooth),
      box-shadow 480ms var(--ease-smooth);
  }

  /*
   * The highlight behind the active row. Neutral, not yellow: translucent
   * yellow over navy mixes to a muddy olive. The active row's number and
   * name turn yellow instead, which is clean.
   */
  .rail-indicator {
    position: absolute;
    top: var(--rail-pad);
    left: var(--rail-pad);
    right: var(--rail-pad);
    height: var(--row-h);
    border-radius: var(--radius-pill);
    background: rgba(252, 250, 249, 0.09);
    transform: translateY(
      calc(var(--active) * (var(--row-h) + var(--row-gap)))
    );
    transition: transform 520ms var(--ease-smooth);
  }

  .rail ol {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
  }

  /*
   * Closing waits 70ms so the labels have faded before the column folds;
   * opening starts at once and runs a little longer, so it feels weighted.
   */
  .rail-link {
    display: grid;
    grid-template-columns: var(--num-w) 0fr;
    align-items: center;
    height: var(--row-h);
    padding: 0 var(--link-pad);
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition:
      grid-template-columns 380ms var(--ease-smooth) 70ms,
      background var(--dur-fast) var(--ease);
  }

  .rail:hover .rail-link,
  .rail:focus-within .rail-link {
    grid-template-columns: var(--num-w) 1fr;
    transition:
      grid-template-columns 480ms var(--ease-smooth),
      background var(--dur-fast) var(--ease);
  }

  /* The cell that clips the name while its column is narrower than it.
     min-width: 0 lets the column shrink below the text's width at all. */
  .rail-label-clip {
    min-width: 0;
    overflow: hidden;
  }

  /* Hover on the other rows: a much fainter wash than the active one, so
     "where you are" and "where you are pointing" never look alike. */
  .rail-link:not(.is-active):hover,
  .rail-link:not(.is-active):focus-visible {
    background: rgba(252, 250, 249, 0.045);
  }

  .rail-num {
    flex: 0 0 var(--num-w);
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    transition: color 300ms var(--ease);
  }

  .rail-label {
    display: block;
    padding-left: var(--label-gap);
    font-family: var(--font-display);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    color: var(--ink);

    /* Closing: gone fast, with no stagger. */
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 140ms var(--ease),
      transform 200ms var(--ease-exit),
      color 300ms var(--ease);
  }

  .rail:hover .rail-label,
  .rail:focus-within .rail-label {
    opacity: 1;
    transform: none;

    /* Opening: each name follows the one above it by 22ms, starting once
       the panel is already on its way out. */
    transition:
      opacity 320ms var(--ease) calc(90ms + var(--i) * 22ms),
      transform 420ms var(--ease-smooth) calc(90ms + var(--i) * 22ms),
      color 300ms var(--ease);
  }

  .rail:hover .rail-num,
  .rail:focus-within .rail-num {
    color: var(--ink-muted);
  }

  /* The section you are in: its number and name in yellow. */
  .rail .rail-link.is-active .rail-num,
  .rail .rail-link.is-active .rail-label {
    color: var(--highlight);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-panel,
    .rail:hover .rail-panel,
    .rail:focus-within .rail-panel,
    .rail-indicator,
    .rail-link,
    .rail:hover .rail-link,
    .rail:focus-within .rail-link,
    .rail-num,
    .rail-label,
    .rail:hover .rail-label,
    .rail:focus-within .rail-label {
      transition: none;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const panel = rail?.querySelector<HTMLElement>('[data-rail-panel]');

  if (rail && panel) {
    const linkEls = [
      ...rail.querySelectorAll<HTMLAnchorElement>('[data-rail-link]'),
    ];


    /*
     * Marks the rail entry for whichever section currently occupies the
     * middle of the screen.
     *
     * rootMargin '-45% 0px -45% 0px' shrinks the observer's window to a
     * thin band across the centre of the viewport. A section is "active"
     * when it crosses that band. Without the margin, three tall sections
     * are all intersecting at once and the highlight flickers between them.
     */
    const ids = linkEls.map((a) => a.dataset.railLink!);
    const targets = ids
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (targets.length > 0) {
      const setActive = (id: string) => {
        const index = ids.indexOf(id);
        if (index < 0) return;
        // Moving --active is what slides the highlight to its new row.
        panel.style.setProperty('--active', String(index));
        linkEls.forEach((a, i) => a.classList.toggle('is-active', i === index));
      };

      /*
       * Which sections are currently across the centre band. A fast scroll
       * (or a jump from a rail click) can deliver several entries in one
       * callback, and assigning as you go would leave whichever happened to
       * be last in the array active. Tracking the set and picking the first
       * in document order makes the result independent of that ordering.
       */
      const visible = new Set<string>();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }

          const first = targets.find((t) => visible.has(t.id));
          if (first) setActive(first.id);
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );

      targets.forEach((t) => observer.observe(t));

      // The band is in the middle of the screen, so at the very top of the
      // page nothing is inside it and the rail would start blank. Show the
      // first entry until the observer has something to say.
      setActive(targets[0].id);
    }
  }
</script>
