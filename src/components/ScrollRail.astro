---
/*
 * The numbered progress rail down the left edge.
 *
 * A fixed column of section numbers that fills in as you scroll and
 * highlights whichever section you are currently inside. It answers two
 * questions a long single-page site otherwise leaves open: how far through
 * am I, and how much is left.
 *
 * ── Decisions worth knowing ────────────────────────────────────────────
 *
 * Desktop only. On a phone it would eat a fifth of the screen width to say
 * something the scrollbar already says, so it only appears from 1380px, the
 * first width with a margin wide enough to hold it beside the content with
 * room to breathe.
 *
 * It is a real <nav> of real anchor links, not decoration. Clicking a number
 * jumps to that section, and the whole rail is reachable by keyboard. The
 * numerals are aria-hidden so a screen reader announces "Software" rather
 * than "zero three Software".
 *
 * IntersectionObserver decides which entry is active, not a scroll handler.
 * A scroll handler here would run on every one of the sixty frames a second
 * Lenis produces and recompute element positions each time; the observer is
 * told once and then only fires when something crosses the line.
 */

interface Props {
  /** In document order. `id` must match the section's id attribute. */
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav class="rail" aria-label="Page sections" data-rail>
  <ol>
    {
      sections.map((s, i) => (
        <li>
          <a href={`#${s.id}`} class="rail-link" data-rail-link={s.id}>
            <span class="rail-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="rail-label">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  /*
   * ── The capsule ─────────────────────────────────────────────────────
   * At rest the rail is a slim floating capsule of numbers. On hover or
   * keyboard focus it widens to show the section names and turns almost
   * opaque, lifted off the page by a shadow.
   *
   * That opacity is the point. The first version was bare numbers on the
   * page, and when its labels slid out they landed on top of whatever
   * body text sat beside them, so the two ran together into one unreadable
   * layer. A solid surface under the labels means the rail always reads
   * as a separate object above the page, never as part of it.
   */
  .rail {
    display: none;
  }

  /*
   * 1380px. The rail must fit in the margin beside the content at rest.
   * The content column is 1200px wide with 32px of padding and the capsule
   * ends 90px from the left edge, so at 1320px it cleared the text by just
   * 2px, which reads as touching. 1380px leaves at least 32px of air. When expanded it deliberately floats over
   * the page, which the opaque surface makes safe.
   */
  @media (min-width: 1380px) {
    .rail {
      display: block;
      position: fixed;
      left: var(--sp-5);
      top: 50%;
      transform: translateY(-50%);
      z-index: var(--z-rail);
    }
  }

  @media (min-width: 1500px) {
    .rail {
      left: var(--sp-6);
    }
  }

  .rail ol {
    list-style: none;
    margin: 0;
    padding: var(--sp-3) var(--sp-2);
    display: flex;
    flex-direction: column;
    gap: 2px;

    border-radius: var(--radius-pill);
    background: rgba(10, 21, 38, 0.55);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: var(--shadow-1);

    transition:
      background var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      border-radius var(--dur) var(--ease);
  }

  /* Expanded: near-opaque, deeper shadow, and a radius that suits a panel
     rather than a pill once it is wider than it is tall. */
  .rail:hover ol,
  .rail:focus-within ol {
    background: var(--surface-menu);
    box-shadow: var(--shadow-2);
    border-radius: var(--radius-lg);
  }

  .rail-link {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 32px;
    padding: 0 var(--sp-3);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease);
  }

  .rail-link:hover,
  .rail-link:focus-visible {
    background: var(--surface-2);
  }

  .rail-num {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .rail-label {
    font-family: var(--font-display);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: var(--track-caps);
    white-space: nowrap;
    /* Full ink, not muted: once the panel is open, the names are the
       thing being read and should be the brightest text in it. */
    color: var(--ink);

    /* Collapsed until the rail opens. Width animates rather than display,
       so it can transition. */
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-width var(--dur) var(--ease),
      opacity var(--dur-fast) var(--ease);
  }

  .rail:hover .rail-label,
  .rail:focus-within .rail-label {
    max-width: 14ch;
    opacity: 1;
  }

  .rail:hover .rail-num,
  .rail:focus-within .rail-num {
    color: var(--ink-muted);
  }

  /*
   * The section you are in. Yellow number with a soft yellow pill behind
   * it, the only yellow on the rail, which is what makes position legible
   * at a glance even while the rail is collapsed.
   */
  .rail-link.is-active {
    background: rgba(254, 198, 1, 0.14);
  }

  .rail-link.is-active .rail-num,
  .rail:hover .rail-link.is-active .rail-num,
  .rail:focus-within .rail-link.is-active .rail-num,
  .rail-link.is-active .rail-label {
    color: var(--highlight);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail ol,
    .rail-link,
    .rail-num,
    .rail-label {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Marks the rail entry for whichever section currently occupies the
   * middle of the screen.
   *
   * rootMargin '-45% 0px -45% 0px' shrinks the observer's window to a thin
   * band across the centre of the viewport. A section is "active" when it
   * crosses that band. Without the margin, three tall sections are all
   * intersecting at once and the highlight flickers between them.
   */
  const rail = document.querySelector<HTMLElement>('[data-rail]');

  if (rail) {
    const links = new Map<string, HTMLAnchorElement>();
    rail
      .querySelectorAll<HTMLAnchorElement>('[data-rail-link]')
      .forEach((a) => links.set(a.dataset.railLink!, a));

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (targets.length > 0) {
      const setActive = (id: string) => {
        links.forEach((a, key) => a.classList.toggle('is-active', key === id));
      };

      /*
       * Which sections are currently across the centre band. A fast scroll
       * (or a jump from a rail click) can deliver several entries in one
       * callback, and looping over them assigning as you go would leave
       * whichever happened to be last in the array active, which is not
       * necessarily the one on screen. Tracking the set and then picking
       * the first in document order makes the result independent of the
       * callback's ordering.
       */
      const visible = new Set<string>();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }

          const first = targets.find((t) => visible.has(t.id));
          if (first) setActive(first.id);
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );

      targets.forEach((t) => observer.observe(t));

      // The band is in the middle of the screen, so at the very top of the
      // page nothing is inside it and the rail would start blank. Show the
      // first entry until the observer has something to say.
      setActive(targets[0].id);
    }
  }
</script>
