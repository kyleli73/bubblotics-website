---
/*
 * Floating bubble field.
 *
 * The team's visual signature: thin rings drifting upward through lit
 * water. They move away from the cursor, and clicking one pops it.
 *
 * The water is not flat. Soft pools of light drift through it and faint
 * shafts fall from the surface at the top right, while the edges and the
 * deep corner sink darker. The bubbles are lit by that same light: one
 * rising through a bright patch glows and its highlight turns to face the
 * light; one in dark water all but disappears.
 *
 * ── Why there are two layers ───────────────────────────────────────────
 * A <canvas> is the only practical way to make dozens of bubbles respond to
 * a pointer smoothly. But canvas draws nothing at all without JavaScript.
 *
 * So the CSS bubbles are still here underneath. They render immediately,
 * they work with JavaScript disabled, and they are what someone who has
 * asked for reduced motion keeps. When the canvas boots it hides them and
 * takes over. Nobody ever sees an empty hero.
 */

interface Props {
  /** Roughly how many bubbles. Scaled down automatically on small screens. */
  count?: number;
  /** 'full' for the home hero, 'subtle' for interior pages. */
  tone?: 'full' | 'subtle';
  class?: string;
}

const { count = 18, tone = 'full', class: className = '' } = Astro.props;

/*
 * Fallback positions, computed at build time so every visitor gets the same
 * arrangement with no layout shift while JS boots.
 */
const bubbles = Array.from({ length: count }, (_, i) => {
  const golden = 0.6180339887;
  const x = ((i * golden * 100) % 100).toFixed(2);
  const size = 14 + ((i * 37) % 100) * (tone === 'full' ? 1.15 : 0.7);
  const duration = 16 + ((i * 23) % 22);
  const delay = -((i * 7.3) % 24);
  const drift = ((i % 5) - 2) * 26;
  const opacity = (tone === 'full' ? 0.5 : 0.28) - ((i % 4) * 0.06);

  return { x, size, duration, delay, drift, opacity };
});
---

<div class={`bubbles ${className}`} data-bubbles data-bubble-count={count} data-tone={tone} aria-hidden="true">
  <!-- The lit water, drawn at quarter resolution: soft light looks the
       same upscaled and costs a sixteenth as much to draw. -->
  <canvas class="light-canvas" data-light-canvas></canvas>
  <canvas class="bubble-canvas" data-bubble-canvas></canvas>

  <!-- Still water for anyone without JavaScript or who has asked for
       reduced motion. Retired once the live canvases are running. -->
  <div class="light-fallback" data-light-fallback></div>

  <div class="bubble-fallback" data-bubble-fallback>
    {
      bubbles.map((b) => (
        <span
          class="bubble"
          style={`
            --x: ${b.x}%;
            --size: ${b.size}px;
            --dur: ${b.duration}s;
            --delay: ${b.delay}s;
            --drift: ${b.drift}px;
            --op: ${b.opacity};
          `}
        />
      ))
    }
  </div>
</div>

<style>
  .bubbles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* pointer-events stay off on the wrapper so the bubbles never block a
       button underneath. The canvas listens on the window instead. */
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 12%,
      #000 72%,
      transparent
    );
    mask-image: linear-gradient(
      to bottom,
      transparent,
      #000 12%,
      #000 72%,
      transparent
    );
  }

  .bubble-canvas,
  .light-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 900ms var(--ease);
  }

  /* Set by the script once the first frame has been drawn, so the canvases
     fade in rather than popping. */
  .bubble-canvas.ready,
  .light-canvas.ready {
    opacity: 1;
  }

  /*
   * Still water: the same idea as the live version without the motion.
   * A pool of light at the top right, a dimmer one low on the left, and
   * the edges falling into shadow.
   */
  .light-fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        60% 70% at 80% 12%,
        rgba(125, 172, 240, 0.14),
        transparent 70%
      ),
      radial-gradient(
        40% 45% at 18% 95%,
        rgba(125, 172, 240, 0.06),
        transparent 70%
      ),
      radial-gradient(
        110% 90% at 55% 35%,
        transparent 55%,
        rgba(3, 8, 16, 0.5) 100%
      );
  }

  .bubbles[data-tone='subtle'] .light-fallback {
    opacity: 0.55;
  }

  .light-fallback.retired {
    display: none;
  }

  .bubble-fallback {
    position: absolute;
    inset: 0;
  }

  /* Hidden once the canvas is running. */
  .bubble-fallback.retired {
    display: none;
  }

  /* ── CSS fallback bubbles ────────────────────────────────────────── */

  .bubble {
    position: absolute;
    left: var(--x);
    bottom: -12%;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    opacity: 0;
    /* The same minimal ring the canvas draws: thin rim, barely any fill. */
    background: rgba(137, 182, 244, 0.04);
    border: 1px solid rgba(170, 200, 245, 0.5);
    animation: rise var(--dur) linear var(--delay) infinite;
    will-change: transform, opacity;
  }

  /* The highlight arc: a ring inset inside the bubble with only its top
     edge drawn, turned toward the upper left. */
  .bubble::before {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    border: 1.5px solid transparent;
    border-top-color: rgba(252, 250, 249, 0.45);
    transform: rotate(-38deg);
  }

  @keyframes rise {
    0% {
      transform: translate3d(0, 0, 0) scale(0.85);
      opacity: 0;
    }
    12% {
      opacity: var(--op);
    }
    50% {
      transform: translate3d(var(--drift), -55vh, 0) scale(1);
    }
    88% {
      opacity: var(--op);
    }
    100% {
      transform: translate3d(calc(var(--drift) * -0.6), -118vh, 0) scale(1.1);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
      opacity: calc(var(--op) * 0.5);
      transform: translate3d(0, -40vh, 0);
    }
    /* Reduced motion keeps the still CSS layers and never starts the
       canvases. */
    .bubble-canvas,
    .light-canvas {
      display: none;
    }
  }
</style>

<script>
  /*
   * ═══════════════════════════════════════════════════════════════════════
   *  INTERACTIVE BUBBLE FIELD
   * ═══════════════════════════════════════════════════════════════════════
   *
   * Deliberately minimal: each bubble is a thin cornflower ring with an
   * almost invisible fill, so it reads as a disc rather than a wire, and one
   * short highlight arc near the top left. That is all.
   *
   * An earlier version drew "convincing" soap bubbles: an iridescent rim in
   * pink, gold and cyan, two reflections, a wobbling outline, and one bubble
   * in five tinted warm. Close up it was impressive; across a whole hero it
   * was busy, and the warm bubbles turned muddy against the navy. Plain
   * rings carry the bubble idea at a glance and let the headline lead.
   *
   * It is also far cheaper: no gradients are created per frame, just two
   * strokes and a fill per bubble.
   *
   * Interaction: bubbles are pushed away from the pointer, and clicking one
   * pops it into a single ring that widens and fades.
   */

  type Bubble = {
    x: number; y: number;      // position, css px
    r: number;                 // radius
    vx: number; vy: number;    // velocity
    drift: number;             // horizontal sway amplitude
    phase: number;             // sway offset so they don't move in lockstep
    alpha: number;
  };

  /* What is left of a popped bubble: a ring that widens and fades out. */
  type Ring = {
    x: number; y: number; r: number; alpha: number; life: number;
    light: number;             // how lit the water was where it popped
  };

  /* Light arriving at a point: how much (0 to 1), and from which angle. */
  type Light = { amount: number; angle: number };

  const fields = document.querySelectorAll<HTMLElement>('[data-bubbles]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    fields.forEach(setup);
  }

  function setup(root: HTMLElement) {
    const el = root.querySelector<HTMLCanvasElement>('[data-bubble-canvas]');
    const fallback = root.querySelector<HTMLElement>('[data-bubble-fallback]');
    const lightEl = root.querySelector<HTMLCanvasElement>('[data-light-canvas]');
    const lightFallback = root.querySelector<HTMLElement>('[data-light-fallback]');
    if (!el || !lightEl) return;

    const ctx = el.getContext('2d');
    if (!ctx) return; // very old browser: keep the CSS bubbles

    /*
     * Re-bound to a non-nullable const after the guard. The functions below
     * are closures, and TypeScript cannot carry a null check across a
     * closure boundary, so referring to the original nullable binding
     * inside them is an error even though it can never be null by then.
     */
    const canvas: HTMLCanvasElement = el;
    const lightCanvas: HTMLCanvasElement = lightEl;
    const lctx = lightCanvas.getContext('2d');
    if (!lctx) return;

    const tone = root.dataset.tone === 'subtle' ? 'subtle' : 'full';
    const baseCount = Number(root.dataset.bubbleCount ?? 18);

    /*
     * ── The light in the water ──────────────────────────────────────────
     * One description of the light, used twice: drawn onto the water
     * canvas, and read back by every bubble to decide how lit it is. That
     * shared source is what makes a bubble brighten exactly as it passes
     * through a patch of light you can see.
     *
     * Positions and sizes are fractions of the field, so the layout holds
     * at any screen size. The brightest light sits at the top right, away
     * from the headline, and is capped so that text over the water keeps
     * its contrast: at most 16% light behind any text (checked against
     * WCAG AA for every piece of hero copy).
     *
     * Everything is cool blue. Warm light over navy mixes to a muddy olive.
     */
    const strength = tone === 'full' ? 1 : 0.55;
    const LIGHT_RGB = '125, 172, 240';
    const POOL_ALPHA = 0.18 * strength;   // centre of the brightest pool
    const SHAFT_ALPHA = 0.07 * strength;  // centre of the brightest shaft
    const LIGHT_SCALE = 0.25;             // water canvas resolution

    // Soft pools of light, each drifting on its own slow loop.
    const pools = [
      { x: 0.8, y: 0.14, dx: 0.05, dy: 0.03, speed: 0.07, phase: 0, size: 0.62, power: 1 },
      { x: 0.52, y: 0.42, dx: 0.07, dy: 0.05, speed: 0.045, phase: 2.1, size: 0.4, power: 0.38 },
      { x: 0.18, y: 0.95, dx: 0.06, dy: 0.02, speed: 0.05, phase: 4.2, size: 0.45, power: 0.3 },
    ];

    // Shafts falling from the surface, leaning down and to the left as if
    // the sun were above and to the right. Each sways very slightly.
    const shafts = [
      { x: 0.6, width: 0.07, tilt: 0.34, power: 0.55, speed: 0.12, phase: 0 },
      { x: 0.74, width: 0.05, tilt: 0.3, power: 0.45, speed: 0.1, phase: 1.9 },
      { x: 0.88, width: 0.1, tilt: 0.38, power: 0.4, speed: 0.14, phase: 3.3 },
    ];

    let w = 0, h = 0, dpr = 1;
    let lw = 1, lh = 1;          // water canvas size, in its own pixels
    let bubbles: Bubble[] = [];
    let rings: Ring[] = [];
    let running = false;
    let raf = 0;
    let t = 0;

    // Pointer position in canvas space, and whether it is actually over us.
    const pointer = { x: -9999, y: -9999, active: false };

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function count() {
      /*
       * Fewer bubbles on a phone. Each one costs several gradient fills per
       * frame, and a mid-range phone rendering 20 of them at 3x pixel ratio
       * will drop frames, which is far more noticeable than having 12.
       */
      if (w < 600) return Math.round(baseCount * 0.5);
      if (w < 1000) return Math.round(baseCount * 0.75);
      return baseCount;
    }

    function spawn(atBottom: boolean): Bubble {
      const big = tone === 'full';
      const r = rand(big ? 8 : 6, big ? 62 : 34);
      return {
        x: rand(0, w),
        // atBottom: entering from below. Otherwise scatter for the first frame
        // so the field starts populated rather than filling up over 20s.
        y: atBottom ? h + r + rand(0, h * 0.4) : rand(-r, h + r),
        r,
        vx: rand(-0.08, 0.08),
        // Bigger bubbles rise faster, as they do in water.
        vy: -rand(0.10, 0.30) * (0.6 + r / 60),
        drift: rand(6, 26),
        phase: rand(0, Math.PI * 2),
        alpha: big ? rand(0.4, 0.85) : rand(0.25, 0.5),
      };
    }

    function resize() {
      const rect = root.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      if (w === 0 || h === 0) return;

      // Cap at 2x. Beyond that the extra pixels are invisible and the fill
      // cost is real, especially on phones that report 3x.
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      lw = Math.max(1, Math.round(w * LIGHT_SCALE));
      lh = Math.max(1, Math.round(h * LIGHT_SCALE));
      lightCanvas.width = lw;
      lightCanvas.height = lh;

      const target = count();
      if (bubbles.length === 0) {
        bubbles = Array.from({ length: target }, () => spawn(false));
      } else if (bubbles.length > target) {
        bubbles.length = target;
      } else {
        while (bubbles.length < target) bubbles.push(spawn(true));
      }
    }

    function poolCentre(p: (typeof pools)[number]) {
      return {
        x: (p.x + p.dx * Math.sin(t * p.speed + p.phase)) * w,
        y: (p.y + p.dy * Math.cos(t * p.speed * 0.8 + p.phase)) * h,
        r: p.size * Math.max(w, h),
      };
    }

    // The pools' brightness against distance: the same curve as the radial
    // gradient that draws them (full, 45% at 0.45 of the radius, then none).
    function poolFalloff(u: number) {
      if (u >= 1) return 0;
      return u < 0.45 ? 1 - u * (0.55 / 0.45) : (0.45 * (1 - u)) / 0.55;
    }

    function shaftTop(s: (typeof shafts)[number]) {
      return (s.x + 0.015 * Math.sin(t * s.speed + s.phase)) * w;
    }

    // Fades in over the first few percent, then thins out with depth.
    function shaftFade(v: number) {
      if (v <= 0 || v >= 1) return 0;
      return v < 0.04 ? v / 0.04 : Math.pow(1 - v, 1.6);
    }

    function shaftHalfWidth(s: (typeof shafts)[number], v: number) {
      return s.width * w * (0.5 + 0.9 * v); // widens as it falls
    }

    /*
     * How much light reaches (x, y), and from where. Mirrors drawLight()
     * exactly, so what a bubble reports matches what you can see.
     */
    function lightAt(x: number, y: number): Light {
      let amount = 0.1;          // a little ambient light everywhere
      let vx = 0, vy = -0.25;    // and, by default, from above

      for (const p of pools) {
        const c = poolCentre(p);
        const dx = c.x - x, dy = c.y - y;
        const d = Math.hypot(dx, dy) || 1;
        const k = p.power * poolFalloff(d / c.r);
        amount += k;
        vx += (dx / d) * k;
        vy += (dy / d) * k;
      }

      for (const s of shafts) {
        const sx = shaftTop(s);
        const dirX = -Math.sin(s.tilt), dirY = Math.cos(s.tilt);
        const len = h * 1.1;
        const rx = x - sx, ry = y;
        const v = (rx * dirX + ry * dirY) / len;
        const perp = Math.abs(rx * dirY - ry * dirX);
        const cross = Math.max(0, 1 - perp / shaftHalfWidth(s, v));
        const k = s.power * cross * shaftFade(v) * 0.9;
        amount += k;
        // Light in a shaft comes from up the shaft, toward the surface.
        vx -= dirX * k;
        vy -= dirY * k;
      }

      // The edges of the water sit in shadow.
      const ex = x - 0.55 * w, ey = y - 0.35 * h, M = Math.max(w, h);
      const dark = Math.min(1, Math.max(0, (Math.hypot(ex, ey) - 0.35 * M) / (0.55 * M)));
      amount *= 1 - 0.7 * dark;

      return { amount: Math.min(1, amount), angle: Math.atan2(vy, vx) };
    }

    function drawLight() {
      const l = lctx!;
      const k = lw / w; // css px to water-canvas px
      l.setTransform(1, 0, 0, 1, 0, 0);
      l.clearRect(0, 0, lw, lh);

      // ── Light. 'lighter' adds overlapping light together, as real light
      // does, so a shaft crossing a pool is brighter than either.
      l.globalCompositeOperation = 'lighter';

      for (const p of pools) {
        const c = poolCentre(p);
        const a = POOL_ALPHA * p.power;
        const g = l.createRadialGradient(c.x * k, c.y * k, 0, c.x * k, c.y * k, c.r * k);
        g.addColorStop(0, `rgba(${LIGHT_RGB}, ${a})`);
        g.addColorStop(0.45, `rgba(${LIGHT_RGB}, ${a * 0.45})`);
        g.addColorStop(1, `rgba(${LIGHT_RGB}, 0)`);
        l.fillStyle = g;
        l.fillRect(0, 0, lw, lh);
      }

      /*
       * Each shaft is drawn standing upright in a rotated frame, as a stack
       * of slices. Every slice is a gradient across the shaft (dark edge,
       * bright middle, dark edge) at the brightness for its depth. A single
       * canvas gradient cannot fade in two directions at once; slices can,
       * and on a quarter-size canvas the steps between them are invisible.
       */
      const slices = 14;
      const len = h * 1.1;
      for (const s of shafts) {
        l.save();
        l.translate(shaftTop(s) * k, 0);
        l.rotate(s.tilt);
        for (let i = 0; i < slices; i++) {
          const v0 = i / slices, v1 = (i + 1) / slices, vm = (v0 + v1) / 2;
          const hw = shaftHalfWidth(s, vm) * k;
          const a = SHAFT_ALPHA * s.power * shaftFade(vm);
          const g = l.createLinearGradient(-hw, 0, hw, 0);
          g.addColorStop(0, `rgba(${LIGHT_RGB}, 0)`);
          g.addColorStop(0.5, `rgba(${LIGHT_RGB}, ${a})`);
          g.addColorStop(1, `rgba(${LIGHT_RGB}, 0)`);
          l.fillStyle = g;
          l.fillRect(-hw, v0 * len * k, hw * 2, (v1 - v0) * len * k + 0.5);
        }
        l.restore();
      }

      // ── Shadow: the edges fall away into deep water.
      l.globalCompositeOperation = 'source-over';
      const M = Math.max(w, h) * k;
      const v = l.createRadialGradient(0.55 * w * k, 0.35 * h * k, 0.35 * M, 0.55 * w * k, 0.35 * h * k, 0.9 * M);
      v.addColorStop(0, 'rgba(3, 8, 16, 0)');
      v.addColorStop(1, `rgba(3, 8, 16, ${0.5 * strength})`);
      l.fillStyle = v;
      l.fillRect(0, 0, lw, lh);
    }

    function drawBubble(b: Bubble) {
      const c = ctx!;
      const { amount: L, angle } = lightAt(b.x, b.y);

      // ── Body and rim. Both scale with the light: in dark water a bubble
      // is a faint outline, in a pool of light it glows.
      c.beginPath();
      c.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      c.fillStyle = `rgba(137, 182, 244, ${b.alpha * (0.02 + 0.07 * L)})`;
      c.fill();
      c.lineWidth = b.r > 30 ? 1.25 : 1;
      c.strokeStyle = `rgba(170, 200, 245, ${b.alpha * (0.18 + 0.62 * L)})`;
      c.stroke();

      // ── Highlight: a short arc on the side facing the light, so bubbles
      // around a pool all point their highlights at it.
      if (b.r > 7) {
        c.beginPath();
        c.arc(b.x, b.y, b.r * 0.72, angle - 0.32, angle + 0.32);
        c.lineWidth = Math.max(1, b.r * 0.045);
        c.lineCap = 'round';
        c.strokeStyle = `rgba(252, 250, 249, ${b.alpha * (0.12 + 0.75 * L)})`;
        c.stroke();
      }

      // ── Reflected light: in bright water, a faint arc on the far side,
      // where light passing through the bubble catches the back wall.
      if (L > 0.35 && b.r > 12) {
        c.beginPath();
        c.arc(b.x, b.y, b.r * 0.8, angle + Math.PI - 0.5, angle + Math.PI + 0.5);
        c.lineWidth = 1;
        c.strokeStyle = `rgba(170, 200, 245, ${b.alpha * (L - 0.35) * 0.5})`;
        c.stroke();
      }
    }

    function pop(b: Bubble) {
      rings.push({ x: b.x, y: b.y, r: b.r, alpha: b.alpha, life: 1, light: lightAt(b.x, b.y).amount });
    }

    function step() {
      const c = ctx!;
      t += 0.016;
      drawLight();
      c.clearRect(0, 0, w, h);

      for (const b of bubbles) {
        // Sway: a slow sine on top of the base velocity, so the path curves
        // instead of running dead straight.
        b.x += b.vx + Math.sin(t * 0.5 + b.phase) * (b.drift * 0.004);
        b.y += b.vy;

        // ── Pointer repulsion ────────────────────────────────────────
        if (pointer.active) {
          const dx = b.x - pointer.x;
          const dy = b.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          const reach = 150 + b.r;
          if (d2 < reach * reach && d2 > 0.01) {
            const d = Math.sqrt(d2);
            // Falls off with distance so the effect has a soft edge rather
            // than a visible circular boundary.
            const force = (1 - d / reach) * 0.9;
            b.vx += (dx / d) * force * 0.35;
            b.vy += (dy / d) * force * 0.35;
          }
        }

        // Damping pulls the bubble back to its natural drift after a shove,
        // otherwise one pass of the cursor sends it off forever.
        b.vx *= 0.965;
        const targetVy = -0.10 * (0.6 + b.r / 60) - 0.06;
        b.vy += (targetVy - b.vy) * 0.02;

        // Recycle off the top, or off the sides after a hard shove.
        if (b.y < -b.r * 2 || b.x < -b.r * 3 || b.x > w + b.r * 3) {
          Object.assign(b, spawn(true));
        }

        drawBubble(b);
      }

      // ── Rings left by popped bubbles ───────────────────────────────
      // About a third of a second each: widening to 1.6x while fading on
      // an eased curve, so it thins out rather than blinking off.
      for (let i = rings.length - 1; i >= 0; i--) {
        const ring = rings[i];
        ring.life -= 0.045;
        if (ring.life <= 0) { rings.splice(i, 1); continue; }

        const grown = ring.r * (1 + (1 - ring.life) * 0.6);
        c.beginPath();
        c.arc(ring.x, ring.y, grown, 0, Math.PI * 2);
        c.lineWidth = 1;
        c.strokeStyle = `rgba(170, 200, 245, ${ring.alpha * (0.25 + 0.55 * ring.light) * ring.life * ring.life})`;
        c.stroke();
      }

      raf = requestAnimationFrame(step);
    }

    function start() {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(step);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    /* ── Pointer tracking ──────────────────────────────────────────────
       Listened for on the window rather than the canvas, because the
       wrapper is pointer-events:none so it never blocks the buttons
       underneath it. Coordinates are converted into canvas space. */
    const onMove = (e: PointerEvent) => {
      const rect = root.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      pointer.active =
        pointer.x > -100 && pointer.x < w + 100 &&
        pointer.y > -100 && pointer.y < h + 100;
    };

    const onLeave = () => { pointer.active = false; };

    const onDown = (e: PointerEvent) => {
      const rect = root.getBoundingClientRect();
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;

      // Pop the bubble under the pointer, if any. Nearest wins when they
      // overlap, so the topmost-looking one is the one that goes.
      let hit: Bubble | null = null;
      let best = Infinity;
      for (const b of bubbles) {
        const d = Math.hypot(b.x - px, b.y - py);
        if (d < b.r && d < best) { best = d; hit = b; }
      }
      if (hit) {
        pop(hit);
        Object.assign(hit, spawn(true));
      }
    };

    window.addEventListener('pointermove', onMove, { passive: true });
    window.addEventListener('pointerdown', onDown, { passive: true });
    document.addEventListener('pointerleave', onLeave);

    /* ── Only animate when actually on screen ─────────────────────────
       A hero scrolled well out of view should not be burning a frame
       budget, and neither should a background tab. */
    const io = new IntersectionObserver(
      (entries) => { entries[0].isIntersecting ? start() : stop(); },
      { threshold: 0 }
    );
    io.observe(root);

    document.addEventListener('visibilitychange', () => {
      document.hidden ? stop() : (io.takeRecords(), start());
    });

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });

    resize();
    if (w > 0 && h > 0) {
      canvas.classList.add('ready');
      lightCanvas.classList.add('ready');
      fallback?.classList.add('retired');
      lightFallback?.classList.add('retired');
      start();
    }
  }
</script>
